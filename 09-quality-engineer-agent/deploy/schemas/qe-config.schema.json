{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qe.example/schemas/qe-config.schema.json",
  "title": "QE-Agent configuration (deploy/qe.yaml)",
  "description": "Validated by `qectl config load` and by PUT /config (API-09). Constants that the SRS fixes (minimum Nelson set, reason on limits, effect size required, numbers only from evidence, DRAFT watermark, rating confirmation) are enforced as `const` so a configuration cannot switch them off.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "spc", "capability", "signals", "correlation", "drafting", "fmea", "export", "glossary", "cases", "golden", "notifications", "retention", "locale"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
    "spc": {
      "type": "object", "additionalProperties": false, "required": ["constants_table", "default_rules", "baseline", "limits", "subgroup_rules"],
      "properties": {
        "constants_table": { "type": "string", "enum": ["montgomery", "astm_e2587"] },
        "default_rules": {
          "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 8 }, "uniqueItems": true, "minItems": 5,
          "description": "FR-02: must contain 1, 2, 3, 5 and 6",
          "allOf": [
            { "contains": { "const": 1 } }, { "contains": { "const": 2 } }, { "contains": { "const": 3 } }, { "contains": { "const": 5 } }, { "contains": { "const": 6 } }
          ]
        },
        "rule_parameters": {
          "type": "object", "additionalProperties": false,
          "properties": { "rule2_run_length": { "type": "integer", "minimum": 7, "maximum": 9 }, "rule3_trend_length": { "type": "integer", "minimum": 6, "maximum": 7 }, "rule5_two_of_three": { "type": "boolean" }, "rule6_four_of_five": { "type": "boolean" } }
        },
        "baseline": {
          "type": "object", "additionalProperties": false, "required": ["default_days", "min_subgroups"],
          "properties": { "default_days": { "type": "integer", "minimum": 7, "maximum": 365 }, "min_subgroups": { "type": "integer", "minimum": 20 } }
        },
        "limits": {
          "type": "object", "additionalProperties": false, "required": ["reason_required", "keep_history"],
          "properties": { "reason_required": { "const": true }, "keep_history": { "const": true } }
        },
        "subgroup_rules": {
          "type": "object", "additionalProperties": false,
          "patternProperties": { "^(xbar_r|x_mr|p|np|c|u)$": { "$ref": "#/$defs/subgroup_rule" } }
        }
      }
    },
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["normality_test", "alpha", "min_n", "non_normal", "print_context_in_exports"],
      "properties": {
        "normality_test": { "const": "anderson_darling" },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
        "min_n": { "type": "integer", "minimum": 30 },
        "non_normal": {
          "type": "object", "additionalProperties": false, "required": ["suppress_cp_cpk", "methods", "recommend"],
          "properties": {
            "suppress_cp_cpk": { "const": true },
            "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["box_cox", "johnson", "percentile_ppk"] } },
            "recommend": { "type": "string", "enum": ["box_cox", "johnson", "percentile_ppk"] }
          }
        },
        "print_context_in_exports": { "const": true }
      }
    },
    "signals": {
      "type": "object", "additionalProperties": false, "required": ["baselines_days", "test", "small_count_test", "alpha", "change_point", "min_sample", "trial_run_suppression", "ranking", "auto_case"],
      "properties": {
        "baselines_days": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 7, "maximum": 90 }, "uniqueItems": true },
        "test": { "const": "two_proportion_z" },
        "small_count_test": { "const": "fisher_exact" },
        "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 },
        "change_point": {
          "type": "object", "additionalProperties": false, "required": ["methods", "window_minutes"],
          "properties": { "methods": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["cusum", "binary_segmentation", "pelt"] } }, "window_minutes": { "type": "integer", "minimum": 5, "maximum": 1440 } }
        },
        "min_sample": { "type": "integer", "minimum": 30, "description": "FR-11 — below 30 a two-proportion test is meaningless" },
        "trial_run_suppression": { "const": true },
        "ranking": {
          "type": "object", "additionalProperties": false, "required": ["weights", "defect_criticality"],
          "properties": {
            "weights": { "$ref": "#/$defs/weights" },
            "defect_criticality": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        "auto_case": {
          "type": "object", "additionalProperties": false, "required": ["open_for", "notify_owner"],
          "properties": {
            "open_for": { "type": "array", "items": { "type": "string", "enum": ["MEDIUM", "HIGH", "CRITICAL"] } },
            "notify_owner": { "type": "boolean" },
            "default_owner_role": { "type": "string", "enum": ["engineer", "manager"] }
          }
        }
      }
    },
    "correlation": {
      "type": "object", "additionalProperties": false, "required": ["factors", "window_days", "tests", "multiple_comparison", "effect_size_required", "meaningful", "timeline_kinds", "retrieval", "hypotheses"],
      "properties": {
        "factors": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "enum": ["material_lot", "machine", "mould", "shift", "operator_group", "sku", "parameter_change", "ambient"] } },
        "window_days": { "type": "integer", "minimum": 7, "maximum": 180 },
        "tests": {
          "type": "object", "additionalProperties": false, "required": ["categorical", "two_group"],
          "properties": { "categorical": { "type": "string", "enum": ["chi_square", "fisher_exact"] }, "two_group": { "type": "string", "enum": ["two_proportion", "rate_ratio"] } }
        },
        "multiple_comparison": { "const": "benjamini_hochberg" },
        "effect_size_required": { "const": true },
        "meaningful": {
          "type": "object", "additionalProperties": false, "required": ["p_adjusted_max", "risk_ratio_min"],
          "properties": { "p_adjusted_max": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 }, "risk_ratio_min": { "type": "number", "minimum": 1.0 } }
        },
        "timeline_kinds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "retrieval": {
          "type": "object", "additionalProperties": false, "required": ["embedding_model", "hybrid", "min_similarity"],
          "properties": {
            "embedding_model": { "type": "string" },
            "hybrid": {
              "type": "object", "additionalProperties": false, "required": ["bm25_weight", "vector_weight", "rerank", "top_k"],
              "properties": { "bm25_weight": { "type": "number", "minimum": 0, "maximum": 1 }, "vector_weight": { "type": "number", "minimum": 0, "maximum": 1 }, "rerank": { "const": true }, "top_k": { "type": "integer", "minimum": 1, "maximum": 20 } }
            },
            "min_similarity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "hypotheses": {
          "type": "object", "additionalProperties": false, "required": ["max", "contra_required", "verify_step_required", "causal_language_only_when_confirmed"],
          "properties": { "max": { "type": "integer", "minimum": 1, "maximum": 10 }, "contra_required": { "const": true }, "verify_step_required": { "const": true }, "causal_language_only_when_confirmed": { "const": true } }
        }
      }
    },
    "drafting": {
      "type": "object", "additionalProperties": false, "required": ["model", "prompts", "facts_schema", "evidence_policy", "term_check"],
      "properties": {
        "model": {
          "type": "object", "additionalProperties": false, "required": ["name", "parameters_b", "temperature", "num_ctx", "timeout_s"],
          "properties": {
            "name": { "type": "string" },
            "parameters_b": { "type": "number", "exclusiveMinimum": 0, "maximum": 9, "description": "AI-03 — local instruct model ≤ 9 B" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 0.3, "description": "AI-03" },
            "num_ctx": { "type": "integer", "minimum": 4096 },
            "timeout_s": { "type": "integer", "minimum": 10, "maximum": 90, "description": "NFR-03" }
          }
        },
        "prompts": {
          "type": "array", "minItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind", "lang", "version", "path"],
            "properties": {
              "kind": { "type": "string", "enum": ["five_why", "eight_d", "fmea", "report", "ocap"] },
              "lang": { "type": "string", "enum": ["th", "ja", "en"] },
              "version": { "type": "string", "pattern": "^v[0-9]+$" },
              "path": { "type": "string", "pattern": "^prompts/[a-z_]+\\.(th|ja|en)\\.v[0-9]+\\.md$" }
            }
          },
          "allOf": [
            { "contains": { "properties": { "kind": { "const": "five_why" } } } },
            { "contains": { "properties": { "kind": { "const": "eight_d" } } } },
            { "contains": { "properties": { "kind": { "const": "fmea" } } } },
            { "contains": { "properties": { "kind": { "const": "report" }, "lang": { "const": "ja" } } } }
          ]
        },
        "facts_schema": { "const": "schemas/facts-object.schema.json" },
        "evidence_policy": {
          "type": "object", "additionalProperties": false, "required": ["numbers_only_from_evidence", "block_approval_on_untraced", "similar_case_summary_max_chars"],
          "properties": { "numbers_only_from_evidence": { "const": true }, "block_approval_on_untraced": { "const": true }, "similar_case_summary_max_chars": { "type": "integer", "minimum": 50, "maximum": 200 } }
        },
        "term_check": {
          "type": "object", "additionalProperties": false, "required": ["enabled", "languages", "block_approval_on_violation"],
          "properties": { "enabled": { "const": true }, "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["ja", "th"] }, "contains": { "const": "ja" } }, "block_approval_on_violation": { "const": true } }
        }
      }
    },
    "fmea": {
      "type": "object", "additionalProperties": false, "required": ["standard", "criteria_table", "require_rating_confirmation", "ocap_suggestions"],
      "properties": {
        "standard": { "type": "string", "enum": ["aiag_vda_ap", "classic_rpn"] },
        "criteria_table": { "type": "string" },
        "ap_table": { "type": "object", "propertyNames": { "pattern": "^(10|[1-9])-(10|[1-9])-(10|[1-9])$" }, "additionalProperties": { "type": "string", "enum": ["L", "M", "H"] } },
        "require_rating_confirmation": { "const": true },
        "ocap_suggestions": { "type": "boolean" }
      },
      "if": { "properties": { "standard": { "const": "aiag_vda_ap" } } },
      "then": { "required": ["ap_table"] }
    },
    "export": {
      "type": "object", "additionalProperties": false, "required": ["formats", "templates_dir", "watermark", "version_stamp", "signed_url_ttl_s", "japanese_report_sections"],
      "properties": {
        "formats": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["docx", "xlsx", "pdf"] }, "uniqueItems": true },
        "templates_dir": { "type": "string" },
        "watermark": {
          "type": "object", "additionalProperties": false, "required": ["draft_text", "every_page"],
          "properties": { "draft_text": { "const": "DRAFT — AI generated" }, "every_page": { "const": true } }
        },
        "version_stamp": { "const": true },
        "signed_url_ttl_s": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "japanese_report_sections": { "type": "array", "const": ["現象", "原因", "対策", "効果確認", "水平展開"] }
      }
    },
    "glossary": {
      "type": "object", "additionalProperties": false, "required": ["source", "domains"],
      "properties": { "source": { "type": "string", "pattern": "\\.csv$" }, "domains": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "cases": {
      "type": "object", "additionalProperties": false, "required": ["effectiveness", "closure", "escalation"],
      "properties": {
        "effectiveness": {
          "type": "object", "additionalProperties": false, "required": ["test", "alpha", "min_after_n"],
          "properties": { "test": { "const": "two_proportion_z" }, "alpha": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.05 }, "min_after_n": { "type": "integer", "minimum": 100 } }
        },
        "closure": {
          "type": "object", "additionalProperties": false, "required": ["require_all_actions_verified_or_cancelled", "require_note", "index_to_knowledge", "horizontal_candidates"],
          "properties": { "require_all_actions_verified_or_cancelled": { "const": true }, "require_note": { "type": "boolean" }, "index_to_knowledge": { "const": true }, "horizontal_candidates": { "type": "boolean" } }
        },
        "escalation": {
          "type": "object", "additionalProperties": false, "required": ["overdue_days", "notify"],
          "properties": { "overdue_days": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }, "notify": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["owner", "manager", "admin"] } } }
        }
      }
    },
    "golden": {
      "type": "object", "additionalProperties": false, "required": ["bucket_prefix", "min_incidents", "top3_rate_min", "fabricated_max", "run_on"],
      "properties": {
        "bucket_prefix": { "type": "string" },
        "min_incidents": { "type": "integer", "minimum": 20, "description": "AI-05" },
        "top3_rate_min": { "type": "number", "minimum": 0.6, "maximum": 1, "description": "AC-04 — may be raised, never lowered" },
        "fabricated_max": { "const": 0 },
        "run_on": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["prompt_change", "model_change", "ranking_change", "facts_schema_change", "schedule"] }, "allOf": [{ "contains": { "const": "prompt_change" } }, { "contains": { "const": "model_change" } }] }
      }
    },
    "notifications": {
      "type": "object", "additionalProperties": false, "required": ["channels", "content"],
      "properties": {
        "channels": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["discord", "email"] } },
        "content": { "const": "statistics_and_links_only" },
        "quiet_hours": { "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/hhmm" }, "end": { "$ref": "#/$defs/hhmm" }, "except": { "type": "array", "items": { "type": "string", "enum": ["HIGH", "CRITICAL"] } } } }
      }
    },
    "retention": {
      "type": "object", "additionalProperties": false, "required": ["measurements_years", "cases_years", "exports_years", "golden_runs_years"],
      "properties": { "measurements_years": { "type": "integer", "minimum": 1 }, "cases_years": { "type": "integer", "minimum": 10 }, "exports_years": { "type": "integer", "minimum": 10 }, "golden_runs_years": { "type": "integer", "minimum": 1 } }
    },
    "locale": {
      "type": "object", "additionalProperties": false, "required": ["default", "supported"],
      "properties": { "default": { "type": "string", "enum": ["th", "ja", "en"] }, "supported": { "type": "array", "const": ["th", "ja", "en"] } }
    }
  },
  "$defs": {
    "hhmm": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "subgroup_rule": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": { "kind": { "type": "string", "enum": ["fixed_n", "time_window", "batch"] }, "n": { "type": "integer", "minimum": 1, "maximum": 25 }, "minutes": { "type": "integer", "minimum": 1 } },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "fixed_n" } } }, "then": { "required": ["n"] } },
        { "if": { "properties": { "kind": { "const": "time_window" } } }, "then": { "required": ["minutes"] } }
      ]
    },
    "weights": {
      "type": "object", "additionalProperties": false, "required": ["impact", "criticality", "volume", "slope"],
      "description": "FR-10 — the loader additionally checks that the four weights sum to 1 ± 1e-9 (JSON Schema cannot express the sum)",
      "properties": { "impact": { "$ref": "#/$defs/unit" }, "criticality": { "$ref": "#/$defs/unit" }, "volume": { "$ref": "#/$defs/unit" }, "slope": { "$ref": "#/$defs/unit" } }
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
