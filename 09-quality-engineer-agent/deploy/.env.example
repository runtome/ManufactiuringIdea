# QE-Agent — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (three roles), JWT/URL-signing keys, S3 keys, SMTP, the Discord
# webhook and the five read-only source connection strings are FILES under ${SECRETS_DIR} (OPS-09 §4.2).
# Rules, baselines, ranking weights, FMEA standard, prompts, glossary, export and retention live in ${CONFIG_DIR}/qe.yaml (schema-validated).
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-09 TC-004).

# ---- images
QE_REGISTRY=registry.internal/qe
QE_VERSION=1.0.0
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://qe.plant.local
SECRETS_DIR=/etc/qe/secrets             # database_url, engine_database_url, exporter_database_url, postgres_password, jwt_secret,
                                        # url_signing_key, s3_access_key, s3_secret_key, smtp_url, discord_webhook,
                                        # source_inspection_url, source_production_url, source_telemetry_url, source_cmms_url, source_erp_url (0400 root:10001)
CONFIG_DIR=/etc/qe                      # qe.yaml, prompts/, schemas/, templates/, glossary.csv
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile
CPU_THREADS=8                           # cpu profile
DEFAULT_LOCALE=th

# ---- database (pgvector/pgvector:pg16)
POSTGRES_DB=qe
POSTGRES_USER=qe
PG_SHARED_BUFFERS=2GB

# ---- redis / object store (ICD-09 IF-10)
REDIS_MAXMEMORY=256mb
S3_REGION=ap-southeast-1
S3_BUCKET_CHARTS=charts                 # regenerable; expires
S3_BUCKET_EXPORTS=exports               # object lock, governance mode, 10 y (NFR-06)
S3_BUCKET_GOLDEN=golden                 # object lock, 5 y (AI-05)
CHARTS_EXPIRE_DAYS=90
SIGNED_URL_TTL_S=900                    # 15 min (SEC-Q42)

# ---- analytics engine (C-02)
CONSTANTS_TABLE=montgomery
ENGINE_WORKERS=4
ENGINE_CPUS=4
ENGINE_MEMORY=4g
REFRESH_INSPECTION_S=300                # IF-49 inspection feed refresh
DETECT_INTERVAL_S=900                   # signal detector cadence (FR-08)
ANALYZE_TIMEOUT_S=20                    # NFR-02
EMBEDDING_MODEL=bge-m3                  # AI-02, multilingual

# ---- drafting (IF-09; AI-03 — model ≤ 9 B, temperature in qe.yaml ≤ 0.3)
DRAFT_MODEL=qwen2.5:7b-instruct
DRAFT_TIMEOUT_S=90                      # NFR-03

# ---- exports (IF-50)
LIBREOFFICE_TIMEOUT_S=60

# ---- governance
APPROVALS_ENABLED=true                  # set false to freeze approvals during an incident (SEC-09 §7)

# ---- notifications (IF-08 / IF-13) — statistics and links only
MAIL_FROM=qe@plant.local

# ---- scheduler (Asia/Bangkok)
DAILY_SIGNAL_CRON=0 6 * * *             # daily signal digest to QC supervisors
ESCALATION_CRON=0 7 * * *               # overdue actions (FR-31)
GOLDEN_RUN_CRON=0 2 * * 0               # weekly golden run (AI-05); also on prompt/model change via qectl
RETENTION_CRON=0 3 1 * *
