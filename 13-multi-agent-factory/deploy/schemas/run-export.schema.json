{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorybrain.plant.local/schemas/kaizenswarm/run-export.v1.json",
  "title": "KaizenSwarm run trace export (IF-72 · SRS-13 FR-07 / NFR-05 / AC-09)",
  "description": "GET /runs/{id}/export. Everything needed to reconstruct a run: the run, every assessment with its budget usage, every message in order, every tool call, every lease and attempt, the ranking, and the sha256 over the ordered message log that swarm.export stores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "assessments", "messages", "tool_calls", "leases", "attempts", "ranking", "message_log_sha256"],
  "properties": {
    "run": {
      "type": "object",
      "required": ["run_no", "trigger", "scope", "started_at", "finished_at", "wall_ms", "status", "partial_reason", "agent_count", "tool_call_count", "token_count", "weights_version"],
      "properties": {
        "run_no": { "type": "integer" },
        "trigger": { "type": "string", "enum": ["schedule", "on_demand", "question", "scenario"] },
        "scope": { "type": "object" },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "wall_ms": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "enum": ["completed", "partial", "failed", "cancelled"] },
        "partial_reason": { "type": ["string", "null"] },
        "agent_count": { "type": "integer", "minimum": 1 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "token_count": { "type": "integer", "minimum": 0 },
        "weights_version": { "type": "string" }
      }
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["agent", "outcome", "incomplete", "finding_count", "tool_calls_used", "tokens_used", "wall_ms", "budget", "freshness_min", "attempt_count"],
        "properties": {
          "agent": { "type": "string" },
          "outcome": { "type": "string", "enum": ["findings", "nothing_significant", "timeout", "budget_exceeded", "invalid_output", "failed", "circuit_open"] },
          "incomplete": { "type": "boolean" },
          "finding_count": { "type": "integer", "minimum": 0 },
          "tool_calls_used": { "type": "integer", "minimum": 0 },
          "tokens_used": { "type": "integer", "minimum": 0 },
          "wall_ms": { "type": "integer", "minimum": 0 },
          "budget": { "type": "object", "required": ["tool_calls", "tokens", "wall_ms"] },
          "freshness_min": { "type": ["number", "null"] },
          "attempt_count": { "type": "integer", "minimum": 1 },
          "error": { "type": ["string", "null"] },
          "agent_run_id": { "type": ["string", "null"] }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seq", "ts", "type", "from", "to", "subject", "payload"],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "ts": { "type": "string", "format": "date-time" },
          "type": { "type": "string", "enum": ["RequestAssessment", "Finding", "Clarification", "Error", "StatusUpdate"] },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "subject": { "type": "string" },
          "payload": { "type": "object" }
        }
      }
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent", "ordinal", "tool", "args", "ok"],
        "properties": {
          "agent": { "type": "string" }, "ordinal": { "type": "integer" }, "tool": { "type": "string" }, "args": { "type": "object" },
          "result_digest": { "type": ["string", "null"] }, "row_count": { "type": ["integer", "null"] }, "duration_ms": { "type": ["integer", "null"] },
          "ok": { "type": "boolean" }, "error": { "type": ["string", "null"] }
        }
      }
    },
    "leases": {
      "type": "array",
      "items": { "type": "object", "required": ["agent", "acquired_at", "released_at"], "properties": { "agent": { "type": "string" }, "model": { "type": "string" }, "acquired_at": { "type": "string" }, "released_at": { "type": ["string", "null"] }, "tokens_in": { "type": ["integer", "null"] }, "tokens_out": { "type": ["integer", "null"] } } }
    },
    "attempts": {
      "type": "array",
      "items": { "type": "object", "required": ["agent", "attempt_no", "outcome"], "properties": { "agent": { "type": "string" }, "attempt_no": { "type": "integer" }, "outcome": { "type": "string" }, "backoff_ms": { "type": "integer" }, "error": { "type": ["string", "null"] } } }
    },
    "ranking": {
      "type": "array",
      "items": { "type": "object", "required": ["rank", "kind", "score", "title"], "properties": { "rank": { "type": "integer" }, "kind": { "type": "string", "enum": ["finding", "compound"] }, "score": { "type": "number" }, "title": { "type": "string" }, "finding_ids": { "type": "array", "items": { "type": "string" } } } }
    },
    "message_log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
