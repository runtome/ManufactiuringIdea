{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorybrain.plant.local/schemas/kaizenswarm/config.v1.json",
  "title": "KaizenSwarm runtime configuration (deploy/kaizenswarm.example.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "plant", "locale", "orchestrator", "bus", "llm", "tools", "blackboard", "scoring", "relation_rules", "briefing", "delivery", "scenarios", "audit", "limits"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "plant": { "type": "object", "required": ["code", "timezone"], "additionalProperties": false, "properties": { "code": { "type": "string", "minLength": 1 }, "timezone": { "type": "string", "minLength": 3 } } },
    "locale": {
      "type": "object", "required": ["primary", "briefing_langs"], "additionalProperties": false,
      "properties": { "primary": { "type": "string", "enum": ["th", "ja", "en"] }, "briefing_langs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["th", "ja", "en"] } } }
    },
    "orchestrator": {
      "type": "object", "required": ["run_wall_s", "agent_timeout_s", "default_budget", "max_attempts", "backoff", "circuit", "partial_on_failure", "schedule"], "additionalProperties": false,
      "properties": {
        "run_wall_s": { "type": "integer", "minimum": 30, "maximum": 180, "description": "NFR-01: a full run ≤ 3 min" },
        "agent_timeout_s": { "type": "integer", "minimum": 5, "maximum": 180, "description": "NFR-02: default 60 s; must be ≤ run_wall_s (checked below)" },
        "default_budget": { "$ref": "#/$defs/budget" },
        "max_attempts": { "type": "integer", "const": 2, "description": "AI-02: one retry on malformed output" },
        "backoff": { "type": "object", "required": ["base_ms", "cap_ms"], "additionalProperties": false, "properties": { "base_ms": { "type": "integer", "minimum": 100 }, "cap_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 } } },
        "circuit": { "type": "object", "required": ["threshold", "cooldown_min"], "additionalProperties": false, "properties": { "threshold": { "type": "integer", "minimum": 1, "maximum": 10 }, "cooldown_min": { "type": "integer", "minimum": 1, "maximum": 240 } } },
        "partial_on_failure": { "type": "boolean", "const": true, "description": "C-06" },
        "schedule": { "type": "object", "required": ["shift_start"], "additionalProperties": false, "properties": { "shift_start": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cron" } }, "daily_summary": { "$ref": "#/$defs/cron" } } }
      }
    },
    "bus": {
      "type": "object", "required": ["transport", "streams", "max_deliver", "ack_wait_s", "max_message_kib"], "additionalProperties": false,
      "properties": {
        "transport": { "type": "string", "enum": ["nats_jetstream", "redis_streams"] },
        "streams": { "type": "object", "required": ["request_retention_h", "finding_retention_d", "status_retention_d", "run_retention_d"], "additionalProperties": false,
                     "properties": { "request_retention_h": { "type": "integer", "minimum": 1 }, "finding_retention_d": { "type": "integer", "minimum": 1 }, "status_retention_d": { "type": "integer", "minimum": 1 }, "run_retention_d": { "type": "integer", "minimum": 1 } } },
        "max_deliver": { "type": "integer", "minimum": 1, "maximum": 5 },
        "ack_wait_s": { "type": "integer", "minimum": 1, "maximum": 60 },
        "max_message_kib": { "type": "integer", "minimum": 8, "maximum": 1024 }
      }
    },
    "llm": {
      "type": "object", "required": ["model", "max_params_b", "temperature", "semaphore_slots", "lease_ttl_s", "prompts", "max_output_tokens"], "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 3 },
        "max_params_b": { "type": "number", "minimum": 0.5, "maximum": 9, "description": "AI-05" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 0.3, "description": "AI-01: phrasing only" },
        "semaphore_slots": { "type": "integer", "const": 1, "description": "C-05" },
        "lease_ttl_s": { "type": "integer", "minimum": 10, "maximum": 180 },
        "prompts": { "type": "object", "required": ["specialist", "manager_explain", "briefing"], "additionalProperties": false,
                     "properties": { "specialist": { "$ref": "#/$defs/promptv" }, "manager_explain": { "$ref": "#/$defs/promptv" }, "briefing": { "$ref": "#/$defs/promptv" } } },
        "max_output_tokens": { "type": "object", "required": ["specialist", "briefing"], "additionalProperties": false, "properties": { "specialist": { "type": "integer", "minimum": 100, "maximum": 4000 }, "briefing": { "type": "integer", "minimum": 100, "maximum": 4000 } } }
      }
    },
    "tools": {
      "type": "object", "required": ["read_only", "default_timeout_ms", "free_text_max_chars", "providers"], "additionalProperties": false,
      "properties": {
        "read_only": { "type": "boolean", "const": true, "description": "C-03" },
        "default_timeout_ms": { "type": "integer", "minimum": 500, "maximum": 30000 },
        "free_text_max_chars": { "type": "integer", "minimum": 50, "maximum": 1000, "description": "SEC-K01" },
        "providers": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "enum": ["qe_agent", "machinesense", "shiftbrief", "erp_adapter", "platform", "stub"] },
          "additionalProperties": { "type": "object", "required": ["base_url", "credential_ref"], "additionalProperties": false,
                                    "properties": { "base_url": { "type": "string", "pattern": "^https://" }, "credential_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$", "description": "name of a secret FILE, never a value" } } }
        }
      }
    },
    "blackboard": {
      "type": "object", "required": ["freshness_threshold_min", "expire_after_runs", "snooze_max_days", "issue_families"], "additionalProperties": false,
      "properties": {
        "freshness_threshold_min": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "expire_after_runs": { "type": "integer", "minimum": 1, "maximum": 10 },
        "snooze_max_days": { "type": "integer", "minimum": 1, "maximum": 30 },
        "issue_families": { "type": "object", "required": ["machine", "lot", "sku", "material", "default"], "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["plant", "line", "machine", "sku", "lot"] } } }
      }
    },
    "scoring": {
      "type": "object", "required": ["weights_version", "impact", "likelihood", "urgency", "compound", "top_n"], "additionalProperties": false,
      "properties": {
        "weights_version": { "type": "string", "pattern": "^v[0-9]+$" },
        "impact": { "type": "object", "required": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"], "additionalProperties": false, "properties": { "INFO": { "$ref": "#/$defs/w" }, "LOW": { "$ref": "#/$defs/w" }, "MEDIUM": { "$ref": "#/$defs/w" }, "HIGH": { "$ref": "#/$defs/w" }, "CRITICAL": { "$ref": "#/$defs/w" } } },
        "likelihood": { "type": "object", "required": ["observed", "trend", "forecast", "possible"], "additionalProperties": false, "properties": { "observed": { "$ref": "#/$defs/w" }, "trend": { "$ref": "#/$defs/w" }, "forecast": { "$ref": "#/$defs/w" }, "possible": { "$ref": "#/$defs/w" } } },
        "urgency": { "type": "object", "required": ["this_shift", "today", "within_3_days", "this_week", "later"], "additionalProperties": false, "properties": { "this_shift": { "$ref": "#/$defs/w" }, "today": { "$ref": "#/$defs/w" }, "within_3_days": { "$ref": "#/$defs/w" }, "this_week": { "$ref": "#/$defs/w" }, "later": { "$ref": "#/$defs/w" } } },
        "compound": { "type": "string", "const": "noisy_or" },
        "top_n": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "relation_rules": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["code", "match_keys", "min_domains", "window_hours", "enabled"], "additionalProperties": false,
                 "properties": { "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" }, "match_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["plant", "line", "machine", "sku", "lot", "shift"] } },
                                 "min_domains": { "type": "integer", "minimum": 2, "maximum": 8 }, "window_hours": { "type": "integer", "minimum": 1, "maximum": 720 }, "enabled": { "type": "boolean" } } }
    },
    "briefing": {
      "type": "object", "required": ["claim_check", "phrasing_retries", "template_fallback", "include_nothing_significant", "freshness_warning"], "additionalProperties": false,
      "properties": { "claim_check": { "type": "boolean", "const": true }, "phrasing_retries": { "type": "integer", "minimum": 0, "maximum": 1 }, "template_fallback": { "type": "boolean", "const": true }, "include_nothing_significant": { "type": "boolean" }, "freshness_warning": { "type": "boolean" } }
    },
    "delivery": {
      "type": "object", "required": ["discord", "immediate_severity", "webhook_allowlist", "email", "dashboard"], "additionalProperties": false,
      "properties": {
        "discord": { "type": "object", "required": ["enabled"], "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "channel_ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" }, "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["th", "ja", "en"] } } } },
        "immediate_severity": { "type": "string", "enum": ["HIGH", "CRITICAL"] },
        "webhook_allowlist": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "email": { "type": "object", "required": ["enabled"], "additionalProperties": false, "properties": { "enabled": { "type": "boolean" }, "to": { "type": "array", "items": { "type": "string" } } } },
        "dashboard": { "type": "boolean", "const": true }
      }
    },
    "scenarios": {
      "type": "object", "required": ["suite_file", "gate", "run_before_activation"], "additionalProperties": false,
      "properties": {
        "suite_file": { "type": "string" },
        "gate": { "type": "object", "required": ["top3_match_min", "fabricated_max", "min_scenarios"], "additionalProperties": false,
                  "properties": { "top3_match_min": { "type": "number", "minimum": 0.8, "maximum": 1 }, "fabricated_max": { "type": "integer", "const": 0 }, "min_scenarios": { "type": "integer", "minimum": 15 } } },
        "run_before_activation": { "type": "boolean", "const": true }
      }
    },
    "audit": { "type": "object", "required": ["retention_days", "export_bucket"], "additionalProperties": false, "properties": { "retention_days": { "type": "integer", "minimum": 365 }, "export_bucket": { "type": "string" } } },
    "limits": { "type": "object", "required": ["runs_per_user_per_hour", "questions_per_user_per_hour"], "additionalProperties": false, "properties": { "runs_per_user_per_hour": { "type": "integer", "minimum": 1, "maximum": 60 }, "questions_per_user_per_hour": { "type": "integer", "minimum": 1, "maximum": 600 } } }
  },
  "$defs": {
    "budget": { "type": "object", "required": ["tool_calls", "tokens", "wall_ms"], "additionalProperties": false,
                "properties": { "tool_calls": { "type": "integer", "minimum": 1, "maximum": 50 }, "tokens": { "type": "integer", "minimum": 200, "maximum": 20000 }, "wall_ms": { "type": "integer", "minimum": 5000, "maximum": 180000 } } },
    "cron": { "type": "string", "pattern": "^([0-9*,/-]+\\s+){4}[0-9*,/-]+$" },
    "promptv": { "type": "string", "pattern": "^[a-z_]+\\.v[0-9]+$" },
    "w": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
