{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorybrain.plant.local/schemas/kaizenswarm/scenario-suite.v1.json",
  "title": "KaizenSwarm scenario suite (IF-71 · SRS-13 AI-06 / AC-01)",
  "description": "≥ 15 synthetic plant states, each a set of specialist findings with the expected top risks. The deterministic half runs in SQL (swarm.run_suite); the LLM half in CI. Identifiers: F<n> = a finding (the first id of a merged group); C:<ids joined by +> = a compound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "version", "weights_version", "gate", "scenarios"],
  "properties": {
    "suite": { "type": "string", "minLength": 3 },
    "version": { "type": "integer", "minimum": 1 },
    "weights_version": { "type": "string", "pattern": "^v[0-9]+$" },
    "gate": {
      "type": "object",
      "required": ["top3_match_min", "fabricated_max"],
      "additionalProperties": false,
      "properties": {
        "top3_match_min": { "type": "number", "minimum": 0.8, "maximum": 1 },
        "fabricated_max": { "type": "integer", "const": 0 }
      }
    },
    "note": { "type": "string" },
    "scenarios": {
      "type": "array",
      "minItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "title", "plant_state", "findings", "expected_top"],
        "properties": {
          "code": { "type": "string", "pattern": "^SC-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 5 },
          "plant_state": { "type": "string", "minLength": 10 },
          "findings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "agent", "domain", "scope", "title", "severity", "likelihood_class", "horizon", "confidence", "issue_code"],
              "properties": {
                "id": { "type": "string", "pattern": "^F[0-9]{1,2}$" },
                "agent": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
                "domain": { "type": "string" },
                "scope": { "type": "object", "required": ["plant"], "additionalProperties": true },
                "title": { "type": "string", "minLength": 5 },
                "severity": { "type": "string", "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
                "likelihood_class": { "type": "string", "enum": ["observed", "trend", "forecast", "possible"] },
                "horizon": { "type": "string", "enum": ["this_shift", "today", "within_3_days", "this_week", "later"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "issue_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
              }
            }
          },
          "expected_top": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(F[0-9]{1,2}|C:F[0-9]{1,2}(\\+F[0-9]{1,2})+)$" }
          }
        }
      }
    }
  }
}
