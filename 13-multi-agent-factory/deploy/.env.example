# KaizenSwarm — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (two roles), JWT, NATS credentials (api, orchestrator, one per
# agent), the lease token, the read-only sibling/ERP tokens, S3 keys, the Discord token/channel are FILES under ${SECRETS_DIR}
# (OPS-13 §4). Policies (budgets, timeouts, weights, rules, gate, retention) live in ${CONFIG_DIR}/kaizenswarm.yaml.
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-13 TC-004).

# ---- images
KS_REGISTRY=registry.internal/kaizenswarm
KS_VERSION=1.0.0
POSTGRES_IMAGE_TAG=pg16
NATS_VERSION=2.11-alpine
REDIS_VERSION=7.4-alpine
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://kaizenswarm.plant.local
SECRETS_DIR=/etc/kaizenswarm/secrets    # database_url, orchestrator_database_url, postgres_password, jwt_secret, nats_api_creds, nats_orchestrator_creds,
                                        # nats_agent_{quality,maintenance,production,material,logistics}, lease_token, qe_agent_token, machinesense_token,
                                        # shiftbrief_token, erp_adapter_token, platform_token, scheduler_token, s3_access_key, s3_secret_key,
                                        # discord_token, discord_channel_id, bot_api_token (0400 root:10001)
CONFIG_DIR=/etc/kaizenswarm             # kaizenswarm.yaml, agents.yaml, schemas/, scenarios/, prompts/, nats/nats.conf
LOG_LEVEL=info
DEFAULT_LOCALE=th
GPU_COUNT=1                             # gpu profile

# ---- database
POSTGRES_DB=kaizenswarm
POSTGRES_USER=kaizenswarm               # password is a secret FILE

# ---- orchestrator (the policy file wins when both are set; these are container defaults)
RUN_WALL_S=180                          # NFR-01
AGENT_TIMEOUT_S=60                      # NFR-02
ORCHESTRATOR_REPLICAS=1
RUNNER_REPLICAS=1                       # scale to 2 for ≥ 8 agents (NFR-04)
TOOL_TIMEOUT_MS=10000
SHIFT_START_CRON=0 6,14 * * *
RETENTION_DAYS=365                      # NFR-05 (≥ 365 enforced by swarm.setting)
RATE_LIMIT_RUNS_PER_HOUR=6              # SEC-K32

# ---- object storage (exports)
S3_ENDPOINT=https://minio.plant.local
S3_BUCKET_EXPORTS=kaizenswarm-exports
