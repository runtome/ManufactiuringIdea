# EdgeGuard node — .env.example
# Copy to /etc/edgeguard/.env (0600). Runtime knobs only; identity and hardware live in node.yaml;
# secrets live in /etc/edgeguard/secrets/. NEVER commit a real .env.
#
# Every ${VAR} referenced by docker-compose.yml and lab-compose.override.yml is listed here (TEST-03 TC-004).

# ---- images: pulled by DIGEST from the plant registry (SEC-E37). Digests come from the signed bundle (app.*).
EDGEGUARD_REGISTRY=registry.plant.local/edgeguard
EDGEGUARD_DIGEST_SUPERVISOR=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_CAPTURE=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_INFERENCE=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_RULES=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_STORE=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_SYNC=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_API=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_HMI=sha256:REPLACE_FROM_BUNDLE
EDGEGUARD_DIGEST_METRICS=sha256:REPLACE_FROM_BUNDLE

# ---- host
TZ=Asia/Bangkok
EDGEGUARD_DATA=/var/lib/edgeguard            # SSD, encrypted volume (SEC-E45)

# ---- devices (per device class — OPS-03 §2)
# Jetson Orin Nano:  GPIO_DEVICE=/dev/gpiochip0  ACCEL_DEVICE=/dev/nvhost-ctrl  CONTAINER_RUNTIME=nvidia  EDGEGUARD_RUNTIME=tensorrt
# x86 + RTX:         GPIO_DEVICE=/dev/ttyUSB0 (I/O module)  ACCEL_DEVICE=/dev/nvidia0  CONTAINER_RUNTIME=nvidia  EDGEGUARD_RUNTIME=tensorrt
# Pi 5 + Hailo-8L:   GPIO_DEVICE=/dev/gpiochip4  ACCEL_DEVICE=/dev/hailo0  CONTAINER_RUNTIME=runc  EDGEGUARD_RUNTIME=hailo
GPIO_DEVICE=/dev/gpiochip0
GPIO_GID=993                                  # `getent group gpio`
CAMERA_DEVICE=/dev/bus/usb                    # USB3 Vision; GigE: /dev/null (uses CAMERA_IFACE); CSI: /dev/video0
CAMERA_IFACE=eth1                             # GigE NIC (dedicated, not the plant LAN); empty for USB/CSI
ACCEL_DEVICE=/dev/nvhost-ctrl
CONTAINER_RUNTIME=nvidia
EDGEGUARD_RUNTIME=tensorrt                    # tensorrt | onnxruntime | hailo
MODEL_PRECISION=fp16                          # fp16 | int8
SHADOW_MIN_FRAMES=200

# ---- store (DDS-03 §1.3)
SQLITE_SYNCHRONOUS=NORMAL                     # NORMAL (WAL, recommended) | FULL
DISK_MIN_FREE_PCT=15
PASS_IMAGE_SAMPLE_RATE=0.02

# ---- sync (ICD-03 IF-01)
SYNC_URL=https://visionops.plant.local        # VisionOps (01) or FactoryBrain (00)
SYNC_AUTH=mtls                                # mtls | key
SYNC_BATCH_MAX=500
SYNC_CONFIG_INTERVAL_S=300
SYNC_HEARTBEAT_INTERVAL_S=60
SYNC_BACKOFF_MAX_S=300
MQTT_URL=                                     # empty = disabled

# ---- local API / HMI (loopback only)
API_PORT=8080
METRICS_PORT=9100
HMI_LANG=th
PIN_MAX_ATTEMPTS_PER_MIN=5
PIN_LOCKOUT_MIN=15
LAB_SOFTWARE_TRIGGER=false                    # true ONLY with lab-compose.override.yml

# ---- edge-lab only (lab-compose.override.yml)
LAB_TOOLS_TAG=1.4.2
LAB_SYNC_URL=https://visionops.lab
LAB_FRAMES_DIR=/srv/edge-lab/frames/MOLD-A12
LAB_REPLAY_MODE=triggered                     # triggered | freerun | frozen | replay-regress
LAB_REPLAY_FPS=10
LAB_TRIGGER_HZ=2
LAB_RELAY_DEVICE=/dev/ttyACM0
