# =====================================================================
# ShiftBrief (Production AI Analyst) — configuration template
# Document : OPS-02-ShiftBrief section 4
# Version  : 1.0
#
#   cp .env.example .env    then edit.   .env MUST NEVER BE COMMITTED.
#   Generate secrets:  openssl rand -base64 36
#
# Legend: [REQUIRED] must be set · [default] safe to leave
# The REFERENCE deployment is CPU-only (ADR-S06). GPU settings are optional.
# =====================================================================

# ---------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------
SB_ENV=production                        # production | staging | dev
SB_PLANT_CODE=P1                         # [REQUIRED] core.plant.code
SB_TIMEZONE=Asia/Bangkok                 # "yesterday" and shift boundaries resolve here
SB_PUBLIC_URL=https://shiftbrief.local   # [REQUIRED]
SB_DEFAULT_LANG=th

# ---------------------------------------------------------------------
# Images (production: pin by digest — SEC-192)
# ---------------------------------------------------------------------
SB_IMAGE_APP=shiftbrief/app:1.0.0
SB_IMAGE_WEB=shiftbrief/web:1.0.0

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
POSTGRES_DB=shiftbrief
POSTGRES_USER=shiftbrief
POSTGRES_PASSWORD=                       # [REQUIRED]
DATABASE_URL=postgresql+psycopg://shiftbrief:${POSTGRES_PASSWORD}@postgres:5432/shiftbrief
AGENT_RO_PASSWORD=                       # [REQUIRED] role for typed tools AND text-to-SQL
DATABASE_URL_AGENT_RO=postgresql+psycopg://agent_ro:${AGENT_RO_PASSWORD}@postgres:5432/shiftbrief
DB_POOL_SIZE=10
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# Object storage (archives, exports, backups)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=                         # [REQUIRED]
MINIO_ROOT_PASSWORD=                     # [REQUIRED]
S3_ENDPOINT=http://minio:9000
S3_BUCKET_ARCHIVES=archives
S3_BUCKET_EXPORTS=exports
S3_SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------
# Cache / queue
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------
# Authentication (inherits SEC-101..109)
# ---------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [REQUIRED]
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem     # [REQUIRED]
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=12
REQUIRE_MFA_FOR_ADMIN=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=                # first boot only, then REMOVE

# ---------------------------------------------------------------------
# Intake (IF-20)
# ---------------------------------------------------------------------
SB_INCOMING_DIR=./incoming               # host path mounted at /data/incoming; one subfolder per source
INGEST_WATCH_INTERVAL_SECONDS=60
INGEST_FILE_STABLE_SECONDS=10            # size unchanged this long = complete
INGEST_MAX_FILE_MB=100
INGEST_XLSX_MAX_RATIO=100                # zip-bomb guard (SEC-S11)
INGEST_XLSX_MAX_CELLS=5000000
INGEST_QUARANTINE_THRESHOLD_PCT=5        # SRS-02 FR-04 — above this the batch is rejected
INGEST_DEFAULT_ENCODING=utf-8
PII_HMAC_KEY=                            # [REQUIRED] SEC-S50/S51 — store separately from DB and backups

# IMAP intake (optional)
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_PROCESSED_FOLDER=Processed
IMAP_SENDER_ALLOWLIST=                   # comma-separated addresses/domains; EMPTY = accept nothing (SEC-S16)
IMAP_POLL_SECONDS=300

# SFTP intake (optional, `sftp` profile)
SFTP_USER=mes
SFTP_PASSWORD=                           # empty = key auth only (recommended)

# ---------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------
FACTS_VERSION=1.0                        # BUMP on any change to how facts are computed (CI enforces)
ANALYTICS_BASELINE_DAYS=7
ANALYTICS_SIGNIFICANCE_ALPHA=0.05
ANALYTICS_MIN_RANK_VOLUME=100            # ADR-S04
ANALYTICS_TREND_RISE_DAYS=3
ANALYTICS_OUTLIER_SIGMA=3.0

# ---------------------------------------------------------------------
# LLM (IF-09) — CPU reference profile
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
LLM_PROFILE=cpu                          # cpu | gpu | external
LLM_MODEL=qwen3:4b                       # CPU: <= 4B Q4.  GPU profile: qwen3:8b
OLLAMA_NUM_THREADS=4
OLLAMA_MEMORY_LIMIT=6g
OLLAMA_KEEP_ALIVE=1h
LLM_TEMPERATURE=0.2                      # 0.0 in tests
LLM_NUM_CTX=8192
BRIEF_MAX_TOKENS_OUT=1024
BRIEF_WALL_SECONDS=300                   # CPU; 60 on GPU
ENABLE_EXTERNAL_LLM=false                # true sends production data off-LAN (SEC-241)
GROUNDING_CHECK_ENABLED=true             # ADR-013 — never disable
GROUNDING_NUMERIC_TOLERANCE=0.005
PROMPT_VERSION=brief.v1.2                # read from templates; shown here for reference

# Ask
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_WALL_SECONDS=60
ENABLE_TEXT_TO_SQL=false                 # ADR-S07 / SEC-S30 — OFF until the eval gate passes; admin-only toggle
TEXT_TO_SQL_ROW_LIMIT=200
TEXT_TO_SQL_TIMEOUT_MS=5000
UNTRUSTED_TEXT_MAX_CHARS=128

# ---------------------------------------------------------------------
# Brief schedule and delivery
# ---------------------------------------------------------------------
CRON_FACTS_REBUILD=40 22 * * *           # after the evening file
CRON_BRIEF_GENERATE=45 6 * * *           # early on CPU so 07:00 delivery holds
CRON_BRIEF_DELIVER=0 7 * * *
BRIEF_DELIVERY_SLO=07:15
BRIEF_RETRY_MINUTES=10

DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ALLOWLIST=               # comma-separated channel ids (SEC-S70)
DISCORD_CHANNEL_ALERTS=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=shiftbrief@example.local
SMTP_RECIPIENT_ALLOWLIST=                # EMPTY = deny all (SEC-S71)

# ---------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------
ALERT_DEFECT_RATE_PCT=4.0
ALERT_DEFECT_RATE_CHANGE_PCT=25.0
ALERT_WITHHELD_BRIEF=true
ALERT_TEXT_TO_SQL_REJECT_PER_HOUR=10
ALERT_DISK_PCT=85

# ---------------------------------------------------------------------
# Retention
# ---------------------------------------------------------------------
RETENTION_ARCHIVE_DAYS=730
RETENTION_FACT_DAYS=1825
RETENTION_BRIEF_DAYS=1825
RETENTION_AGENT_RUN_DAYS=730
RETENTION_AUDIT_DAYS=730

# ---------------------------------------------------------------------
# Observability / backup / TLS
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=                  # [REQUIRED]
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=                   # [REQUIRED] store elsewhere (SEC-247)
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key

# =====================================================================
# PRE-FLIGHT — before the first real brief goes to a channel people read
#   [ ] Every [REQUIRED] set; .env in .gitignore, mode 600
#   [ ] BOOTSTRAP_ADMIN_PASSWORD removed after first login; 2 admins with MFA
#   [ ] PII_HMAC_KEY set and backed up somewhere other than this server
#   [ ] GROUNDING_CHECK_ENABLED=true · ENABLE_TEXT_TO_SQL=false · ENABLE_EXTERNAL_LLM=false
#   [ ] IMAP_SENDER_ALLOWLIST and SMTP_RECIPIENT_ALLOWLIST populated (empty denies)
#   [ ] Mapping dry-run passed on a real file; expectation set; test brief reviewed by a person
#   [ ] CPU brief latency measured and CRON_BRIEF_GENERATE set early enough for the SLO
#   [ ] seed_demo.sql removed from the ../db mount on a production database
# =====================================================================
