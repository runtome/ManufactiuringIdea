# MachineSense — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. OT credentials, DB password, JWT secret, Discord/SMTP/CMMS secrets are
# FILES under ${SECRETS_DIR} (OPS-06 §4.2). Sensor map and alert rules live in ${CONFIG_DIR} (schema-validated).
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-06 TC-004).

# ---- images
MS_REGISTRY=registry.internal/machinesense
MS_VERSION=1.0.0
TIMESCALE_IMAGE_TAG=2.17.2-pg16
MOSQUITTO_VERSION=2.0.20
OLLAMA_VERSION=0.6.8

# ---- host and networks
TZ=Asia/Bangkok
PLANT_TZ=Asia/Bangkok
BIND_ADDR=10.0.30.5                  # server-side LAN interface for api/web (never 0.0.0.0)
OT_BIND_ADDR=10.20.0.5               # OT-facing interface of the ingest host for the broker listener
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://machinesense.plant.local
SECRETS_DIR=/etc/machinesense/secrets   # database_url, postgres_password, jwt_secret, mqtt_ingest, opcua/<credential_ref>,
                                        # opcua_client.crt/.key, mosquitto_passwd, mosquitto_tls/, discord_bot_token, smtp_url,
                                        # alert_webhook_hmac, cmms_webhook_hmac  (0400 root:10001)
CONFIG_DIR=/etc/machinesense            # sensors.yaml, alert-rules.yaml, mosquitto.conf, mosquitto.acl
GPU_COUNT=1                             # 0 on CPU-only hosts

# ---- database (own TimescaleDB)
POSTGRES_DB=machinesense
POSTGRES_USER=app_rw
PG_SHARED_BUFFERS=4GB

# ---- ingest (ICD-06 IF-04/05/06)
MQTT_URL=mqtts://mosquitto:8883
MQTT_TOPIC_ROOT=factory/BKK-1
BUFFER_MAX_HOURS=24                     # NFR-05
INGEST_BATCH_ROWS=5000
GAP_FACTOR=3
STUCK_N=30
SKEW_S=5                                # NFR-09
OPCUA_RECONNECT_MAX_S=60
MODBUS_POLL_TIMEOUT_S=1

# ---- pipeline (SAD-06 §4.3)
FEATURE_WINDOWS_S=60,600
FEATURE_LAG_TARGET_S=60                 # NFR-02
FEATURE_WORKERS=4
SCORING_INTERVAL_S=60
EWMA_LAMBDA=0.2

# ---- agent (IF-09)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
PROMPT_VERSION=p-2026.09
LLM_TIMEOUT_S=30
ASK_MAX_TOOL_CALLS=6
GENBA_MEMORY_URL=                       # empty = local similar-case search only (FR-24 standalone)
DEFAULT_LANG=th

# ---- scheduler
ROLLUP_CRON=5 * * * *
RETENTION_CRON=30 2 * * *
RETRAIN_CRON=0 3 1 * *
WEEKLY_RISKS_CRON=0 8 * * 1
SENSOR_HEALTH_INTERVAL_S=300
RETENTION_RAW_DAYS=90
RETENTION_ROLLUP_DAYS=730
RETENTION_FEATURE_DAYS=730

# ---- delivery (IF-08, IF-13, IF-37)
DISCORD_GUILD_ID=000000000000000000
DISCORD_CHANNEL_ID=000000000000000001
ALERT_WEBHOOK_URL=                      # empty = disabled
CMMS_WEBHOOK_URL=                       # empty = PDF export only
