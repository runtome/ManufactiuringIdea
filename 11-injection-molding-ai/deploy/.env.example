# MoldMind — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (four roles), JWT and URL-signing keys, S3 keys, service tokens,
# the OPC-UA client certificate/key, the machines' read-only OPC-UA accounts, MQTT credentials, SMTP and Discord are FILES under
# ${SECRETS_DIR} (OPS-11 §4.2). Policies (windows, scoring, KB rules, thresholds, gates, retention) live in ${CONFIG_DIR}/moldmind.yaml.
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-11 TC-004).

# ---- images
MM_REGISTRY=registry.internal/moldmind
MM_VERSION=1.0.0
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://moldmind.plant.local
SECRETS_DIR=/etc/moldmind/secrets       # database_url, gateway_database_url, vision_database_url, kb_database_url, postgres_password, jwt_secret,
                                        # url_signing_key, s3_access_key, s3_secret_key, gateway_service_token, qe_service_token, opcua_client_cert,
                                        # opcua_client_key, opcua_readonly_m3 (one per machine), mqtt_readonly, smtp_url, discord_webhook (0400 root:10001)
CONFIG_DIR=/etc/moldmind                # moldmind.yaml, machines/, kb/, prompts/, schemas/, glossary.csv
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile (vision + dialogue share the card on the baseline)
CPU_THREADS=8                           # cpu profile
DEFAULT_LOCALE=th

# ---- database (pgvector/pgvector:pg16; TimescaleDB optional — OPS-11 §10)
POSTGRES_DB=moldmind
POSTGRES_USER=moldmind
PG_SHARED_BUFFERS=2GB

# ---- redis / object store (ICD-11 IF-10)
REDIS_MAXMEMORY=256mb
S3_REGION=ap-southeast-1
S3_BUCKET_PARTS=parts                   # part images; PASS images expire, defect images kept
S3_BUCKET_COLOUR=colour                 # reference chart frames (versioned)
S3_BUCKET_EVAL=eval                     # vision / golden evaluation artefacts (object lock, 5 y)
PASS_IMAGES_EXPIRE_DAYS=90
SIGNED_URL_TTL_S=900                    # 15 min

# ---- machine gateways (IF-05; C-01 / NFR-06 — read-only accounts, enforced on the press)
BUFFER_HOURS=24                         # NFR-05
SHOT_LATENCY_BUDGET_S=2                 # NFR-01
MQTT_URL=mqtts://mqtt.ot.plant.local:8883   # mqtt profile only

# ---- camera side (IF-02 / IF-58)
CAMERA_STATION_URL=http://10.30.2.11:9000    # edge capture service at the part-exit station (camera network)
INFERENCE_BUDGET_MS=150                 # NFR-02
REVIEW_THRESHOLD=0.70                   # FR-11
COLOUR_FORMULA=cie76                    # AI-04 (cie2000 optional)
ALIGN_TOLERANCE_MS=1500                 # FR-03
CAVITY_METHODS=ocr_marking,robot_position,sequence   # FR-08 — tried in this order

# ---- analysis
ANALYSIS_INTERVAL_S=300
CAVITY_ALPHA=0.01                       # FR-12
TRANSIENT_SHOTS=20                      # FR-16
ANALYSER_CPUS=2
ANALYSER_MEMORY=2g

# ---- RCA dialogue (IF-09; AI-06 — dialogue and explanation only; ≤ 9 B; temperature in moldmind.yaml ≤ 0.3)
DIALOGUE_MODEL=qwen2.5:7b-instruct-q4_K_M
DIALOGUE_TIMEOUT_S=15                   # NFR-04

# ---- QE-Agent handoff (FR-26, IF-62)
QE_URL=http://qe.plant.local/api/v1
HANDOFF_RETRY_MINUTES=15

# ---- governance
SESSIONS_ENABLED=true                   # set false to freeze RCA sessions during an incident (SEC-11 §7)

# ---- notifications (statistics and links only)
MAIL_FROM=moldmind@plant.local

# ---- scheduler (Asia/Bangkok)
RETENTION_CRON=0 3 * * *
PARTITION_CRON=0 2 25 * *               # next month's shot partition
KB_STALE_CRON=0 4 * * 1                 # weekly stale-cause report
