# GAPFarm AI — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (four roles), JWT and URL-signing keys, S3 keys, LINE channel
# token/secret, Discord webhook, push keys, SMTP, the weather API key and the MQTT credentials are FILES under ${SECRETS_DIR}
# (OPS-12 §4.2). Policies (thresholds, PHI enforcement, quiet hours, gates, retention) live in ${CONFIG_DIR}/gapfarm.yaml.
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-12 TC-004).

# ---- images
GF_REGISTRY=registry.internal/gapfarm
GF_VERSION=1.0.0
POSTGRES_IMAGE_TAG=16-3.4-pgvector
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
MOSQUITTO_VERSION=2.0
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
MQTT_BIND_ADDR=0.0.0.0                  # 8883 (TLS, per-device credentials) must be reachable by field devices; firewall to the farm's IP range (OPS-12 §5.1)
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://gapfarm.example.th
SECRETS_DIR=/etc/gapfarm/secrets        # database_url, vision_database_url, agent_database_url, ingest_database_url, postgres_password, jwt_secret,
                                        # url_signing_key, s3_access_key, s3_secret_key, line_channel_token, line_channel_secret, discord_webhook,
                                        # fcm_server_key, vapid_private, smtp_url, weather_api_key, mqtt_ingest, mqtt_passwd, mqtt_acl, mqtt_certs/ (0400 root:10001)
CONFIG_DIR=/etc/gapfarm                 # gapfarm.yaml, schemas/, schemes/, inputs/, prompts/, glossary.csv
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile
CPU_THREADS=4                           # cpu profile (pilot baseline: 4 vCPU / 8 GB — NFR-09)
DEFAULT_LOCALE=th

# ---- database (postgis/postgis:16-3.4 + pgvector, built from deploy/postgres/Dockerfile)
POSTGRES_DB=gapfarm
POSTGRES_USER=gapfarm
PG_SHARED_BUFFERS=1GB

# ---- redis / object store (ICD-12 IF-10)
REDIS_MAXMEMORY=128mb
S3_REGION=ap-southeast-1
S3_BUCKET_PHOTOS=photos                 # EXIF-free, versioned (immutable evidence); refused/ prefix expires
S3_BUCKET_EXPORTS=exports               # audit packages, object lock 5 y
S3_BUCKET_LABELS=labels                 # registered product labels
S3_BUCKET_MODELS=models                 # server + device artefacts with manifests
S3_BUCKET_PDPA=pdpa                     # data-request packages, 7 d
EXPORT_RETENTION_DAYS=1826
REFUSED_PHOTO_EXPIRE_DAYS=30
SIGNED_URL_TTL_S=900                    # 15 min (NFR-06)
MAX_PHOTO_BYTES=1048576

# ---- diagnosis (IF-64)
SERVER_MODEL_VERSION=chili-v3
DEVICE_MODEL_VERSION=chili-v3-lite      # ≤ 25 MB (AI-04)
INFERENCE_BUDGET_S=8                    # NFR-01

# ---- agent (IF-09; AI-07 — explain and orchestrate only; ≤ 9 B; temperature in gapfarm.yaml ≤ 0.3)
AGENT_ENABLED=true                      # set false to freeze /ask during an advice-integrity incident (SEC-12 §6, RB-10)
AGENT_MODEL=qwen2.5:7b-instruct-q4_K_M
AGENT_TIMEOUT_S=15

# ---- weather (IF-12.2)
WEATHER_PROVIDER=open-meteo             # open-meteo | tmd ; dev profile: point WEATHER_PROVIDER at weather.mock through the provider adapter
WEATHER_REFRESH_MINUTES=60

# ---- sensors (IF-12.1; mqtt profile)
BUFFER_HOURS=24                         # NFR-07
LATE_SKEW_MINUTES=10
FAULT_SCAN_INTERVAL_S=900               # FR-22

# ---- notifications (IF-67 LINE, IF-40 push, IF-08 Discord, IF-13 mail) — tokens are secret files
LINE_LOGIN_CHANNEL_ID=1650000000
VAPID_PUBLIC_KEY=BExamplePublicKeyReplaceAtBootstrap
MAIL_FROM=gapfarm@example.th

# ---- scheduler (Asia/Bangkok)
RETENTION_CRON=0 3 * * *
PARTITION_CRON=0 2 25 * *               # next month's telemetry partition
GAP_SCAN_CRON=0 5 * * *                 # FR-15 compliance gaps
WEEKLY_SUMMARY_CRON=0 6 * * 1           # FR-32
