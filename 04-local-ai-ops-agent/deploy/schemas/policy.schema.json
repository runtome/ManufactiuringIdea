{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opspilot.internal/schemas/policy.schema.json",
  "title": "OpsPilot policy file",
  "description": "Loaded by PUT /policies (owner) into ops.policy. One entry per write tool; per-environment overrides. C-03: auto_execute is never allowed for high-risk tools — enforced here, in the API and by a DB trigger.",
  "type": "object",
  "required": ["version", "environments", "actions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[0-9]+)?$" },
    "environments": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["prod", "staging", "dev"] }
    },
    "defaults": { "$ref": "#/$defs/actionPolicy" },
    "actions": {
      "type": "object",
      "description": "Keys are registry tool names of kind=write. Deny-listed names are refused by the loader regardless of content.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{2,40}$", "not": { "pattern": "(shell|exec|eval|sql|query_raw|volume_rm|system_prune|force_push|drop_|truncate)" } },
      "additionalProperties": {
        "type": "object",
        "required": ["risk"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string", "enum": ["low", "medium", "high"] },
          "default": { "$ref": "#/$defs/actionPolicy" },
          "environments": {
            "type": "object",
            "propertyNames": { "enum": ["prod", "staging", "dev"] },
            "additionalProperties": { "$ref": "#/$defs/actionPolicy" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "risk": { "const": "high" } } },
            "then": {
              "properties": {
                "default": { "properties": { "auto_execute": { "const": false } } },
                "environments": { "additionalProperties": { "properties": { "auto_execute": { "const": false } } } }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "actionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "boolean" },
        "require_role": { "type": "string", "enum": ["operator", "admin", "owner"] },
        "auto_execute": { "type": "boolean", "description": "Opt-in per action per environment. Never true for risk=high (C-03)." },
        "rate_limit": {
          "type": "object",
          "required": ["max", "window_s"],
          "additionalProperties": false,
          "properties": {
            "max": { "type": "integer", "minimum": 1, "maximum": 100 },
            "window_s": { "type": "integer", "minimum": 60, "maximum": 604800 },
            "key": { "type": "string", "enum": ["target", "target+service"], "default": "target" }
          }
        },
        "targets_allow": { "type": ["array", "null"], "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" }, "uniqueItems": true }
      }
    }
  }
}
