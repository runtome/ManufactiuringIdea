# OpsPilot — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Secrets are FILES under ${SECRETS_DIR} (see OPS-04 §4.2) — never here.
# Every ${VAR} referenced by docker-compose.yml is listed (TEST-04 TC-004).

# ---- images
OPSPILOT_REGISTRY=registry.internal/opspilot
OPSPILOT_VERSION=1.0.0
OLLAMA_VERSION=0.6.8
PROMETHEUS_VERSION=v2.54.1
LOKI_VERSION=3.2.0

# ---- host
TZ=Asia/Bangkok
BIND_ADDR=10.0.20.5                  # the OpsPilot host's INTERNAL interface. Never 0.0.0.0 (SEC-O23)
API_PORT=8080
CONSOLE_PORT=3000
SECRETS_DIR=/etc/opspilot/secrets    # files: database_url, postgres_password, jwt_secret, discord_bot_token,
                                     #        discord_service_token, smtp_url, alert_webhook_hmac, targets/<code>.* (0400 root:10001)
CONFIG_DIR=/etc/opspilot             # targets.yaml, runbooks/, prometheus.yml (no secrets)
GPU_COUNT=1                          # 0 on CPU-only hosts (use a <= 4B model then)

# ---- database (the OpsPilot DB — not a target DB)
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot_app

# ---- auth (SEC-O22, O23)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12
MFA_REQUIRED_ROLES=admin,owner
ASK_RATE_PER_MIN=30
APPROVE_RATE_PER_MIN=10
LOGIN_RATE_PER_10MIN=10

# ---- LLM (IF-09, AI-01, AI-04)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
PROMPT_VERSION=p-2026.09
REGISTRY_VERSION=1.0.0
MAX_ITERATIONS=8
TOOL_BUDGET_S=60
TOOL_TIMEOUT_S=10
LLM_TIMEOUT_S=30
LLM_BREAKER_FAILURES=3

# ---- tools (IF-16 caps)
LOG_MAX_LINES=2000
LOG_MAX_BYTES=262144

# ---- optional sources (empty = disabled)
PROMETHEUS_URL=
LOKI_URL=

# ---- scheduler (FR-25, FR-26, retention)
SWEEP_CRON=0 8 * * *
ALERT_EVAL_INTERVAL_S=300
RETENTION_RESULTS_DAYS=90
RETENTION_METADATA_DAYS=730
ALERT_WEBHOOK_URL=

# ---- Discord (IF-08)
DISCORD_GUILD_ID=000000000000000000
DISCORD_CHANNEL_IDS=000000000000000001,000000000000000002
