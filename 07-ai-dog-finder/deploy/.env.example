# PawTrace — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs, JWT/URL-signing keys, S3 keys, VAPID/FCM, CAPTCHA and SMTP
# secrets are FILES under ${SECRETS_DIR} (OPS-07 §4.2). The configuration document (fusion weights, fuzz precision, limits)
# lives in ${CONFIG_DIR}/pawtrace.yaml and is loaded through the API (schema-validated).
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-07 TC-004).

# ---- images
PT_REGISTRY=registry.internal/pawtrace
PT_VERSION=1.0.0
POSTGRES_IMAGE_TAG=16-3.4-pgvector0.7
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only public listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://pawtrace.example
SECRETS_DIR=/etc/pawtrace/secrets       # database_url, public_database_url, postgres_password, jwt_secret, url_signing_key,
                                        # s3_access_key, s3_secret_key, vapid_private, fcm_server_key, captcha_secret, smtp_url  (0400 root:10001)
CONFIG_DIR=/etc/pawtrace                # pawtrace.yaml
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile only

# ---- database
POSTGRES_DB=pawtrace
POSTGRES_USER=pawtrace
PG_SHARED_BUFFERS=4GB
PG_MAINTENANCE_WORK_MEM=2GB             # HNSW builds (DDS-07 §7)

# ---- redis / object store (ICD-07 IF-10)
REDIS_MAXMEMORY=512mb
S3_REGION=ap-southeast-1
S3_BUCKET_DERIVATIVES=derivatives       # EXIF-free derivatives only — there is no originals bucket (C-04)
S3_BUCKET_CROPS=crops
S3_BUCKET_EXPORTS=exports
S3_BUCKET_INTAKE=intake

# ---- api
SESSION_DAYS=30
MAGIC_LINK_TTL_S=600
MAX_UPLOAD_MB=12
PUBLIC_ROUTES_ENABLED=true              # set false to take the public map/search offline (SEC-07 §7)
CAPTCHA_PROVIDER=turnstile              # turnstile | hcaptcha (IF-41)
CAPTCHA_SITE_KEY=SET_AT_BOOTSTRAP       # public site key (the secret is a file)
GEOCODER_URL=https://nominatim.openstreetmap.org   # or a self-hosted Photon/Nominatim (IF-39)
MAP_TILES_URL=https://tiles.example/styles/basic/{z}/{x}/{y}.png
MAP_TILES_KEY=SET_AT_BOOTSTRAP          # public tile key, client-side
DEFAULT_LOCALE=th
MAIL_FROM=PawTrace <no-reply@pawtrace.example>
RELAY_DOMAIN=relay.pawtrace.example     # thread-<id>@relay… (FR-07)

# ---- push (IF-40)
VAPID_PUBLIC_KEY=SET_AT_BOOTSTRAP       # public half; the private key is a file
VAPID_SUBJECT=mailto:ops@pawtrace.example

# ---- workers (IF-42)
VISION_BATCH_GPU=16
VISION_BATCH_CPU=2
REEMBED_BATCH_GPU=256
REEMBED_BATCH_CPU=32
CPU_THREADS=8
NSFW_AUTO_HIDE=0.90

# ---- scheduler
MATCH_RERUN_CRON=*/30 * * * *           # FR-17 re-run for active reports
EXPIRY_CRON=10 * * * *
DIGEST_CRON=0 18 * * *                  # FR-25 digest (local time)
RETENTION_CRON=30 2 * * *
CALIBRATION_CRON=15 3 * * *             # AI-04
DELETION_SWEEP_CRON=*/15 * * * *        # NFR-06 object removal
RATE_LIMIT_MIRROR_CRON=5 * * * *
