# GenbaGo — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (app_rw, worker_rw), the postgres password, JWT, the IF-16 tool
# token, the bot's API token, MinIO root and app keys, the Discord token/channel are FILES under ${SECRETS_DIR} (OPS-14 §4).
# Policies (thresholds, gates, roles, retention, prompts) live in ${CONFIG_DIR}/genbago.yaml and in genba.setting.
# There is NO cloud MT key: a confidential job (the default) runs locally only, and no cloud provider is configured (C-03, SEC-J11).
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-14 TC-004).

# ---- images
GB_REGISTRY=registry.internal/genbago
GB_VERSION=1.0.0

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
MAILPIT_PORT=8025                       # dev profile
PUBLIC_URL=https://genbago.plant.local
SECRETS_DIR=/etc/genbago/secrets        # postgres_password, database_url, worker_database_url, jwt_secret, tool_token, bot_api_token,
                                        # minio_root_user, minio_root_password, s3_access_key, s3_secret_key, discord_token, discord_channel_id (0400 root:10001)
CONFIG_DIR=/etc/genbago                 # genbago.yaml, schemas/, prompts/, check-items.yaml
LOG_LEVEL=info
DEFAULT_LOCALE=th                       # NFR-06: th | ja | en

# ---- database
POSTGRES_DB=genbago
POSTGRES_USER=genbago                   # password is a secret FILE

# ---- queues / cache
REDIS_MAXMEMORY=512mb

# ---- object storage (IF-10)
S3_BUCKET_DOCS=genbago-docs             # uploads, versioned, private
S3_BUCKET_RESULTS=genbago-results       # translated documents, side-by-side PDFs, keep-layout images
S3_BUCKET_EXPORTS=genbago-exports       # TBX / TMX / CSV exports, object lock
S3_BUCKET_INDEX=genbago-index           # indexed documents (standalone mode; platform mode uses Genba Memory, IF-19)

# ---- model (IF-09) — the model name, size cap and temperature are in genbago.yaml / genba.setting
LLM_SEMAPHORE_SLOTS=1                   # one 8 GB GPU
OLLAMA_KEEP_ALIVE=30m
TRANSLATE_BATCH=12                      # segments per model call

# ---- OCR (IF-76)
OCR_ENGINE=paddleocr-ja-vertical-2.7    # must equal ocr.engine in genbago.yaml; models in the ocr-models volume (OPS-14 §7)

# ---- documents (IF-77)
MAX_FILE_MB=50
INDEX_INTERVAL_S=300

# ---- api
SIGNED_URL_MINUTES=15                   # SEC-J21 (≤ 15)
RATE_LIMIT_TRANSLATE_PER_MIN=60

# ---- scheduler
EVAL_SCHEDULE=0 6 1 * *                 # monthly evaluation (AI-02/AI-05/AI-08)
RETENTION_DAYS=365                      # NFR-05 (≥ 365 enforced by genba.setting)

# ---- notifications (IF-13)
SMTP_HOST=mailpit                       # plant: smtp.plant.local
SMTP_PORT=1025
SMTP_FROM=genbago@plant.local
