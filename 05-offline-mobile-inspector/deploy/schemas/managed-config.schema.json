{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorybrain.plant.local/schemas/pocketqc/managed-config.schema.json",
  "title": "PocketQC managed configuration (Android Enterprise app restrictions)",
  "description": "Delivered by the MDM (ICD-05 IF-33). The app has no settings screen for these. No secrets: pins are public SPKI hashes; credentials come from login.",
  "type": "object",
  "required": [
    "server_url",
    "cert_pins",
    "device_id"
  ],
  "additionalProperties": false,
  "properties": {
    "server_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$"
    },
    "cert_pins": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256/[A-Za-z0-9+/]{43}=$"
      }
    },
    "device_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]{2,30}$"
    },
    "sync_network": {
      "type": "string",
      "enum": [
        "wifi",
        "any"
      ],
      "default": "wifi"
    },
    "offline_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 30
    },
    "gps_enabled": {
      "type": "boolean",
      "default": false
    },
    "allowed_share_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "require_device_lock": {
      "type": "boolean",
      "default": true
    },
    "lang_default": {
      "type": "string",
      "enum": [
        "th",
        "ja",
        "en"
      ],
      "default": "th"
    },
    "low_space_warn_pct": {
      "type": "integer",
      "minimum": 5,
      "maximum": 50,
      "default": 20
    },
    "low_space_crit_pct": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 10
    },
    "debug_diagnostics": {
      "type": "boolean",
      "default": false
    }
  }
}
