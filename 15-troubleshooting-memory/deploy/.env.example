# Genba Memory — environment for docker-compose.yml  (OPS-15 §3)
# Copy to .env and edit. This file carries NO secrets: every credential is a file under
# ${SECRETS_DIR} and reaches a container as a *_FILE reference (OPS-15 §4, SEC-H30).
# There is deliberately no variable here for an external model, embedding or translation
# endpoint — none exists, and TEST-15 TC-004 checks that it stays that way (C-04, NFR-06).

TZ=Asia/Bangkok
LOG_LEVEL=info

# --- images ----------------------------------------------------------------
GM_REGISTRY=registry.factory.local/genbamemory
GM_VERSION=1.0.0

# --- exposure ---------------------------------------------------------------
BIND_ADDR=127.0.0.1                 # put a reverse proxy in front; nothing binds 0.0.0.0
PUBLIC_URL=https://memory.factory.local
WEB_PORT=3010
API_PORT=8010
MAILPIT_PORT=8125
DEFAULT_LOCALE=th

# --- database ---------------------------------------------------------------
POSTGRES_DB=genbamemory
POSTGRES_USER=postgres

# --- object storage ---------------------------------------------------------
S3_BUCKET_ORIGINALS=memory-originals   # versioned + object-lock: the C-01 guarantee
S3_BUCKET_OCR=memory-ocr
S3_BUCKET_EXPORTS=memory-exports
S3_BUCKET_TMP=memory-tmp

# --- models (all in-cluster) ------------------------------------------------
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=bge-reranker-v2-m3
RERANK_DEPTH=30                     # AI-05
OLLAMA_KEEP_ALIVE=30m
LLM_SEMAPHORE_SLOTS=2

# --- pipeline ---------------------------------------------------------------
INGEST_CONCURRENCY=4
OCR_CONFIDENCE_GATE=0.95
REEMBED_BATCH_SIZE=1000
EVAL_SCHEDULE=0 3 1 * *

# --- api --------------------------------------------------------------------
SIGNED_URL_MINUTES=15
RATE_LIMIT_SEARCH_PER_MIN=120

# --- notifications ----------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=memory@factory.local
ALERT_MIN_SEVERITY=recurrence

# --- retention --------------------------------------------------------------
RETENTION_DAYS_ORIGINALS=730

# --- secrets ----------------------------------------------------------------
# Sixteen files, created by OPS-15 §4. Never values, here or anywhere in the repository.
SECRETS_DIR=./secrets
CONFIG_DIR=./config
