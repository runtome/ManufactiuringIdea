{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factorybrain.local/schemas/genbamemory/case-extract-1.0.json",
  "title": "IF-79 — Case extraction contract (SRS-15 FR-08…FR-13, AI-01, NFR-08)",
  "description": "What worker-extract returns for one document. Every field carries its own confidence and its own provenance: the structure indexes the document, it never replaces it (C-01, ADR-H03). Nothing in this contract can assert that a value is verified — verification is a human event recorded elsewhere (C-02).",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "model", "prompt_version", "schema_version", "doc_class", "lang", "case", "fields"],
  "properties": {
    "document_id": { "$ref": "#/$defs/uuid" },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "prompt_version": { "type": "string", "pattern": "^[a-z0-9-]+\\.v[0-9]+$" },
    "schema_version": { "type": "string", "const": "case-extract-1.0" },
    "temperature": { "type": "number", "minimum": 0, "maximum": 0.3 },
    "doc_class": {
      "type": "string",
      "enum": ["eight_d", "rca", "maintenance_log", "work_order", "handover", "complaint", "other"]
    },
    "lang": { "type": "string", "enum": ["th", "ja", "en"] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "scope"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 300 },
        "opened_at": { "type": ["string", "null"], "format": "date-time" },
        "closed_at": { "type": ["string", "null"], "format": "date-time" },
        "status": { "type": ["string", "null"], "enum": ["open", "closed", "unknown", null] },
        "outcome": { "type": ["string", "null"], "enum": ["resolved", "not_resolved", "unknown", null] },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "machine": { "type": ["string", "null"] },
            "line": { "type": ["string", "null"] },
            "sku": { "type": ["string", "null"] },
            "mould": { "type": ["string", "null"] }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
    "descriptors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defect_class": { "type": ["string", "null"] },
        "failure_mode": { "type": ["string", "null"] },
        "alarm_code": { "type": ["string", "null"], "pattern": "^(AL|E|ER|F)-?[0-9]{2,4}$" },
        "deviation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parameter", "value", "unit"],
          "properties": {
            "parameter": { "type": "string" },
            "value": { "type": "number" },
            "unit": { "type": "string" },
            "nominal": { "type": "number" },
            "delta": { "type": "number" }
          }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "confidence", "provenance"],
      "properties": {
        "field": {
          "type": "string",
          "enum": ["title", "opened_at", "closed_at", "scope", "symptom", "investigation",
                   "cause", "containment", "corrective_action", "verification", "outcome", "status"]
        },
        "value": { "type": ["string", "null"], "maxLength": 4000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["document_id", "page"],
          "description": "Where in the original this came from. A machine-written field without it cannot be stored (trg_field_provenance).",
          "properties": {
            "document_id": { "$ref": "#/$defs/uuid" },
            "page": { "type": "integer", "minimum": 1 },
            "section": { "type": "string" },
            "char_start": { "type": "integer", "minimum": 0 },
            "char_end": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "raw_value", "mapped"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["machine", "line", "sku", "mould", "defect_class", "alarm_code"]
        },
        "raw_value": { "type": "string", "minLength": 1 },
        "canonical_id": { "type": ["string", "null"] },
        "mapped": { "type": "boolean" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "allOf": [
        {
          "description": "FR-10: a value is mapped only when it resolves to a canonical id; otherwise it goes to curation.",
          "if": { "properties": { "mapped": { "const": true } }, "required": ["mapped"] },
          "then": { "required": ["canonical_id"], "properties": { "canonical_id": { "type": "string", "minLength": 1 } } }
        }
      ]
    }
  }
}
