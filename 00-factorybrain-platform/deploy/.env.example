# =====================================================================
# FactoryBrain AI Platform — configuration template
# Document : OPS-00-FactoryBrain section 4 (configuration reference)
# Version  : 1.0
#
#   cp .env.example .env    then edit.
#
# .env CONTAINS SECRETS AND MUST NEVER BE COMMITTED.
# Ensure `.env` is in .gitignore before you create it (SEC-244).
#
# Generate secrets with:
#   openssl rand -base64 36
#
# Legend:  [REQUIRED] must be set   ·   [default] safe to leave alone
# =====================================================================

# ---------------------------------------------------------------------
# Identity and public URL
# ---------------------------------------------------------------------
FB_ENV=production                      # production | staging | dev
FB_PLANT_CODE=P1                       # [REQUIRED] matches core.plant.code
FB_TIMEZONE=Asia/Bangkok               # plant-local timezone for date resolution
FB_PUBLIC_URL=https://factorybrain.local   # [REQUIRED] used in links and CORS
FB_DEFAULT_LANG=th                     # th | ja | en

# ---------------------------------------------------------------------
# Container images  (production: pin by digest, not tag — SEC-192)
# ---------------------------------------------------------------------
FB_IMAGE_APP=factorybrain/app:1.0.0
FB_IMAGE_WEB=factorybrain/web:1.0.0
FB_WORKER_REPLICAS=2

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
POSTGRES_DB=factorybrain
POSTGRES_USER=factorybrain
POSTGRES_PASSWORD=                     # [REQUIRED] openssl rand -base64 36
DATABASE_URL=postgresql+psycopg://factorybrain:${POSTGRES_PASSWORD}@postgres:5432/factorybrain

# Least-privilege roles created by schema.sql. Give each its own password.
DATABASE_URL_AGENT_RO=postgresql+psycopg://agent_ro:${AGENT_RO_PASSWORD}@postgres:5432/factorybrain
AGENT_RO_PASSWORD=                     # [REQUIRED] role used by the agent tool layer
EDGE_INGEST_PASSWORD=                  # [REQUIRED] role used by the edge sync endpoint

DB_POOL_SIZE=20                        # per API worker; 4 workers x 20 < max_connections
DB_POOL_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=30000          # hard stop for runaway queries

# ---------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------
MINIO_ROOT_USER=                       # [REQUIRED]
MINIO_ROOT_PASSWORD=                   # [REQUIRED] openssl rand -base64 36
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_REPORTS=reports
S3_BUCKET_MODELS=models
S3_SIGNED_URL_TTL_SECONDS=900          # 15 min (SEC-165). Do not raise casually.

# ---------------------------------------------------------------------
# Cache / queue / locks
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
GPU_SEMAPHORE_KEY=fb:gpu
GPU_SEMAPHORE_TTL_SECONDS=120          # lock auto-expires if a holder dies
GPU_SEMAPHORE_WAIT_TIMEOUT_SECONDS=45  # exceeded -> 503 MODEL_UNAVAILABLE

# ---------------------------------------------------------------------
# Authentication  (SEC-101..109)
# ---------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [REQUIRED] RS256
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem     # [REQUIRED]
JWT_ACCESS_TTL_MINUTES=15              # SEC-101
JWT_REFRESH_TTL_HOURS=12               # SEC-102 — one shift, deliberately
JWT_ISSUER=factorybrain
REQUIRE_MFA_FOR_ADMIN=true             # SEC-103. Do not disable in production.
LOGIN_MAX_ATTEMPTS=10                  # SEC-106
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Bootstrap admin. Used ONCE on an empty database, then delete these lines
# and rotate the password through the UI (OPS section 3.4).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=              # set for first boot only, then remove

# ---------------------------------------------------------------------
# LLM  (C-01, C-02, ADR-003)
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama                    # ollama | openai_compatible
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:8b                     # must fit 8 GB VRAM at Q4_K_M
LLM_EMBEDDING_MODEL=bge-m3             # multilingual TH/JA/EN, 1024-dim
LLM_TEMPERATURE=0.2                    # briefs and artifacts; 0.0 in tests
LLM_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# External provider — off by default. Enabling this sends factory data
# outside the LAN and is an explicit, logged admin decision (SEC-241).
ENABLE_EXTERNAL_LLM=false
EXTERNAL_LLM_BASE_URL=
EXTERNAL_LLM_API_KEY=

# Agent budgets, enforced by the executor not by the model (SEC-224)
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_WALL_SECONDS=60
AGENT_MAX_TOKENS_OUT=1024
AGENT_PROPOSAL_TTL_SECONDS=600         # approval window (SEC-222)

# Grounding gate (ADR-013, SEC-230). Disabling this removes the platform's
# central integrity guarantee; it exists only for controlled experiments.
GROUNDING_CHECK_ENABLED=true
GROUNDING_NUMERIC_TOLERANCE=0.005      # tolerates display rounding, not invention
ENABLE_TEXT_TO_SQL=false               # ADR-005: behind a flag until its eval gate passes

# ---------------------------------------------------------------------
# Vision
# ---------------------------------------------------------------------
VISION_MODEL_NAME=defect-yolo11s
VISION_MODEL_VERSION=1.0.0
VISION_INPUT_SIZE=640
VISION_RUNTIME=onnxruntime             # onnxruntime | tensorrt
VISION_REVIEW_THRESHOLD_DEFAULT=0.55   # per-SKU override lives in vision.recipe
MODEL_CACHE_DIR=/models
MODEL_VERIFY_SHA256=true               # SEC-181. Never disable.

# ---------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------
INGEST_WATCH_DIR=/data/incoming
INGEST_ARCHIVE_BUCKET=documents
INGEST_MAX_FILE_MB=100
INGEST_QUARANTINE_THRESHOLD_PCT=5      # SRS 6.3 — above this the batch is rejected
INGEST_EXPECTED_DAILY_BY=09:00         # alert if the daily file has not arrived

# IMAP intake (DocFlow) — optional
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------------
# Telemetry (IF-04, IF-05, IF-06)
# ---------------------------------------------------------------------
MQTT_ENABLED=false
MQTT_HOST=mqtt
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_CA=/certs/ca.crt
MQTT_TOPIC_PREFIX=factory

OPCUA_ENABLED=false
OPCUA_CONFIG_PATH=/config/opcua_nodes.yaml    # per-machine node mapping
OPCUA_SECURITY_POLICY=Basic256Sha256
OPCUA_USERNAME=                        # MUST be a read-only account (SEC-261)
OPCUA_PASSWORD=

# ---------------------------------------------------------------------
# ERP (IF-07)
# ---------------------------------------------------------------------
ERP_ADAPTER=csv_export                 # rest | soap | staging_table | csv_export
ERP_BASE_URL=
ERP_USERNAME=
ERP_PASSWORD=
ERP_TIMEOUT_SECONDS=30
ERP_MAX_POST_ATTEMPTS=5
ERP_EXPORT_DIR=/data/erp_export
DOCFLOW_APPROVAL_THRESHOLD=100000      # above this: manager role + segregation of duties
DOCFLOW_STRAIGHT_THROUGH=false         # SRS-08 FR-29: OFF by default, per-supplier opt-in

# ---------------------------------------------------------------------
# Notifications (IF-08, IF-13)
# ---------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_BRIEF=
DISCORD_CHANNEL_ALERTS=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=factorybrain@example.local
SMTP_RECIPIENT_ALLOWLIST=              # comma-separated; empty = deny all (SEC)

WEBHOOK_URL=
WEBHOOK_HMAC_SECRET=                   # payloads are signed so receivers can verify

# ---------------------------------------------------------------------
# Alerting thresholds  (runtime-tunable copies live in ops.config)
# ---------------------------------------------------------------------
ALERT_DEFECT_RATE_PCT=4.0
ALERT_DEFECT_RATE_WINDOW_HOURS=8
ALERT_EDGE_HEARTBEAT_MISSES=3
ALERT_EDGE_BUFFER_DEPTH=5000
ALERT_DISK_PCT=85
ALERT_GROUNDING_FAILURE_PCT=1.0        # rising rate = model drifting to fabrication

# ---------------------------------------------------------------------
# Retention  (SRS 6.2)
# ---------------------------------------------------------------------
RETENTION_PASS_IMAGE_DAYS=30
RETENTION_FAIL_IMAGE_DAYS=730
RETENTION_INSPECTION_DAYS=1825
RETENTION_TELEMETRY_RAW_DAYS=90
RETENTION_AGENT_RUN_DAYS=730
RETENTION_AUDIT_DAYS=730               # export before any partition drop (SEC-145)
PASS_IMAGE_SAMPLE_RATE=0.02            # main lever on object-storage growth

# ---------------------------------------------------------------------
# Scheduled jobs (cron, plant-local time)
# ---------------------------------------------------------------------
CRON_DAILY_BRIEF=0 7 * * *
CRON_RETENTION_SWEEP=0 2 * * *
CRON_BACKUP_FULL=0 1 * * *
CRON_PARTITION_MAINTAIN=0 3 1 * *
CRON_DRIFT_CHECK=0 */6 * * *

# ---------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------
LOG_LEVEL=INFO                         # DEBUG only for troubleshooting; it is verbose
LOG_FORMAT=json
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=                # [REQUIRED]
SENTRY_DSN=                            # optional; leave empty for air-gapped

# ---------------------------------------------------------------------
# Backup
# ---------------------------------------------------------------------
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=                 # [REQUIRED] SEC-247; store separately from backups

# ---------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key
TLS_CA_PATH=/certs/ca.crt              # internal CA; also trusted by edge nodes
EDGE_REQUIRE_MTLS=true                 # false falls back to X-Edge-Key (weaker)

# =====================================================================
# PRE-FLIGHT CHECKLIST — confirm before first production start
#
#   [ ] Every [REQUIRED] value is set, and none is a default or example
#   [ ] .env is in .gitignore and has file mode 600
#   [ ] BOOTSTRAP_ADMIN_PASSWORD removed after first login
#   [ ] REQUIRE_MFA_FOR_ADMIN=true
#   [ ] ENABLE_EXTERNAL_LLM=false unless deliberately and knowingly enabled
#   [ ] GROUNDING_CHECK_ENABLED=true
#   [ ] MODEL_VERIFY_SHA256=true
#   [ ] OPCUA_USERNAME is a read-only account, verified against the machine
#   [ ] SMTP_RECIPIENT_ALLOWLIST populated (empty denies all sending)
#   [ ] BACKUP_ENCRYPTION_KEY stored somewhere other than this server
#   [ ] Images pinned by digest
# =====================================================================
