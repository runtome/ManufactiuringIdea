# =====================================================================
# VisionOps (AI Factory Inspector Agent) — configuration template
# Document : OPS-01-VisionOps section 4
# Version  : 1.0
#
#   cp .env.example .env    then edit.   .env MUST NEVER BE COMMITTED.
#   Generate secrets:  openssl rand -base64 36
#
# Legend: [REQUIRED] must be set · [default] safe to leave
# In PLATFORM MODE only the EDGE and CAPTURE sections apply (SAD-01 §9).
# =====================================================================

# ---------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------
VO_ENV=production                        # production | staging | dev
VO_PLANT_CODE=P1                         # [REQUIRED] core.plant.code
VO_LINE_CODE=L2                          # default line for this deployment
VO_TIMEZONE=Asia/Bangkok
VO_PUBLIC_URL=https://visionops.local    # [REQUIRED] links, CORS
VO_EDGE_SYNC_URL=https://visionops.local:8443   # mTLS listener for edge nodes
VO_DEFAULT_LANG=th

# ---------------------------------------------------------------------
# Images  (production: pin by digest — SEC-192)
# ---------------------------------------------------------------------
VO_IMAGE_APP=visionops/app:1.0.0
VO_IMAGE_WEB=visionops/web:1.0.0
VO_IMAGE_EDGE=visionops/edge:1.0.0
VO_WORKER_REPLICAS=2

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
POSTGRES_DB=visionops
POSTGRES_USER=visionops
POSTGRES_PASSWORD=                       # [REQUIRED]
DATABASE_URL=postgresql+psycopg://visionops:${POSTGRES_PASSWORD}@postgres:5432/visionops
AGENT_RO_PASSWORD=                       # [REQUIRED] role used by the narrative tools
EDGE_INGEST_PASSWORD=                    # [REQUIRED] role used by /edge/*
DATABASE_URL_AGENT_RO=postgresql+psycopg://agent_ro:${AGENT_RO_PASSWORD}@postgres:5432/visionops
DB_POOL_SIZE=15                          # 4 workers x 15 < max_connections 150
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------
MINIO_ROOT_USER=                         # [REQUIRED]
MINIO_ROOT_PASSWORD=                     # [REQUIRED]
S3_ENDPOINT=http://minio:9000
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_MODELS=models
S3_BUCKET_REPORTS=reports
S3_SIGNED_URL_TTL_SECONDS=900            # 15 min (SEC-165)

# ---------------------------------------------------------------------
# Cache / locks
# ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
GPU_SEMAPHORE_KEY=vo:gpu
GPU_SEMAPHORE_TTL_SECONDS=120
GPU_SEMAPHORE_WAIT_TIMEOUT_SECONDS=45
GPU_INFERENCE_PRIORITY=true              # allinone: frames before narratives (ADR-V01)

# ---------------------------------------------------------------------
# Authentication  (inherits SEC-101..109)
# ---------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem   # [REQUIRED]
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem     # [REQUIRED]
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=12                 # one shift
REQUIRE_MFA_FOR_ADMIN=true               # do not disable
LOGIN_MAX_ATTEMPTS=10
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=                # first boot only, then REMOVE

# ---------------------------------------------------------------------
# Edge sync (IF-01)
# ---------------------------------------------------------------------
EDGE_REQUIRE_MTLS=true                   # false falls back to X-Edge-Key (weaker)
EDGE_BATCH_MAX=500
EDGE_IMAGE_WINDOW=                       # e.g. "22:00-05:00"; empty = anytime
EDGE_IMAGE_BANDWIDTH_KBPS=4000
EDGE_HEARTBEAT_STALE_SECONDS=180
EDGE_CONFIG_POLL_SECONDS=60

# ---------------------------------------------------------------------
# Capture & inference (edge / allinone)
# ---------------------------------------------------------------------
CAPTURE_SOURCE=folder                    # genicam | usb | rtsp | folder
VO_CAMERA_DEVICE=/dev/video0             # usb source only
VO_REPLAY_DIR=./replay                   # folder source only (demo)
CAPTURE_TRIGGER_MODE=hardware            # hardware | software | freerun
CAPTURE_EXPOSURE_US=800                  # FIXED — never auto (drift detection depends on it)
CAPTURE_GAIN_DB=0
CAPTURE_PIXEL_FORMAT=Mono8
CAPTURE_ROI=                             # x,y,w,h ; empty = full frame
QUALITY_GATE_MIN_BLUR_VARIANCE=120       # recipe may override
QUALITY_GATE_EXPOSURE_RANGE=40,220
FROZEN_FRAME_DETECT=true                 # SEC-V40 — do not disable
CAMERA_DISCONNECT_ALARM_SECONDS=10

VISION_MODEL_NAME=defect-yolo11s
VISION_MODEL_VERSION=1.0.0
VISION_INPUT_SIZE=640
VISION_RUNTIME=tensorrt                  # tensorrt | onnxruntime
VISION_PRECISION=fp16                    # fp16 | int8 (int8 must pass the recall gate)
ANOMALY_MODEL_NAME=patchcore-rad500
ANOMALY_ENABLED=true                     # escalates to REVIEW only (ADR-V05)
OCR_ENABLED=true
MODEL_CACHE_DIR=/models
MODEL_VERIFY_SHA256=true                 # SEC-V31 — never disable
TENSORRT_BUILD_ON_DEVICE=true            # ADR-010

# ---------------------------------------------------------------------
# Verdict I/O (IF-03) — per-station map lives in vision.station.plc_io_json
# ---------------------------------------------------------------------
PLC_IO_DRIVER=gpio                       # gpio | modbus_io | none (folder demo)
PLC_VERDICT_PULSE_MS=200
PLC_VERDICT_TIMEOUT_MS=400
PLC_FAULT_ON_INVALID_CALIBRATION=true    # when a measurement rule is active
LOCAL_STORE_MIN_FREE_PCT=15              # below this: stop PASS images, keep inspecting

# ---------------------------------------------------------------------
# Evidence & retention
# ---------------------------------------------------------------------
PASS_IMAGE_SAMPLE_RATE=0.02              # main storage lever (ADR-V09)
RETENTION_PASS_IMAGE_DAYS=30
RETENTION_FAIL_IMAGE_DAYS=730
RETENTION_INSPECTION_DAYS=1825
RETENTION_AGENT_RUN_DAYS=730
RETENTION_AUDIT_DAYS=730
RETENTION_PROTECT_SNAPSHOTS=true         # SEC-V63 — never delete snapshot-referenced images

# ---------------------------------------------------------------------
# Narrative agent (IF-09, IF-16)
# ---------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
ENABLE_EXTERNAL_LLM=false                # true sends factory data off-LAN (SEC-241)
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_WALL_SECONDS=60
AGENT_MAX_TOKENS_OUT=1024
AGENT_PROPOSAL_TTL_SECONDS=600
GROUNDING_CHECK_ENABLED=true             # ADR-013 — never disable
GROUNDING_NUMERIC_TOLERANCE=0.005
NARRATIVE_BASELINE_DAYS=7
NARRATIVE_SIGNIFICANCE_ALPHA=0.05
UNTRUSTED_TEXT_MAX_CHARS=256             # ocr_text / lot / note cap in prompts (SEC-V71)

# ---------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------
ALERT_DEFECT_RATE_PCT=4.0
ALERT_DEFECT_RATE_WINDOW_HOURS=8
ALERT_NO_READ_PCT=2.0                    # NO_READ share over 15 min → lighting/camera
ALERT_REVIEW_QUEUE_DEPTH=200
ALERT_OVERRIDE_BURST_COUNT=30            # SEC-V52
ALERT_OVERRIDE_BURST_MINUTES=10
ALERT_MANUAL_SKU_PCT=5.0                 # IF-15
ALERT_DRIFT_SIGMA=3.0
ALERT_GROUNDING_FAILURE_PCT=1.0
ALERT_EDGE_HEARTBEAT_MISSES=3
ALERT_EDGE_BUFFER_DEPTH=5000
ALERT_DISK_PCT=85

# ---------------------------------------------------------------------
# Delivery
# ---------------------------------------------------------------------
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_NARRATIVE=
DISCORD_CHANNEL_ALERTS=
CRON_DAILY_NARRATIVE=5 22 * * *
CRON_SHIFT_NARRATIVE=5 14,22 * * *
CRON_AGREEMENT_STATS=0 23 * * *
CRON_RETENTION_SWEEP=0 2 * * *
CRON_BACKUP_FULL=0 1 * * *
CRON_PARTITION_MAINTAIN=0 3 1 * *
CRON_DRIFT_CHECK=0 */6 * * *

# ---------------------------------------------------------------------
# Observability / backup / TLS
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=                  # [REQUIRED]
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPTION_KEY=                   # [REQUIRED] store elsewhere (SEC-247)
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key
TLS_CA_PATH=/certs/ca.crt

# =====================================================================
# PRE-FLIGHT — confirm before enabling the reject signal
#   [ ] Every [REQUIRED] set; .env in .gitignore, mode 600
#   [ ] BOOTSTRAP_ADMIN_PASSWORD removed after first login; 2 admins with MFA
#   [ ] GROUNDING_CHECK_ENABLED=true · MODEL_VERIFY_SHA256=true · FROZEN_FRAME_DETECT=true
#   [ ] CAPTURE_EXPOSURE_US fixed (not auto) and recorded on the station
#   [ ] Calibration verified with the gauge on every camera (v_current_calibration = all)
#   [ ] PLC verified: verdict absence → hold (TC-023); FAULT → hold (TC-022)
#   [ ] 30-minute disconnection test passed (TC-061 short form)
#   [ ] Shadow run reviewed before the active model judged real product
#   [ ] seed_demo.sql removed from the ../db mount on a production database
# =====================================================================
