# DocFlow — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs, JWT/URL-signing keys, S3 keys, the IMAP credential, the SFTP key,
# the ERP token, SMTP, webhook HMAC and any cloud-model key are FILES under ${SECRETS_DIR} (OPS-08 §4.2).
# Policies, gates, STP, tolerances, adapters, intake sources and retention live in ${CONFIG_DIR}/docflow.yaml (schema-validated).
# Every ${VAR} referenced by docker-compose.yml is listed here (TEST-08 TC-004).

# ---- images
DF_REGISTRY=registry.internal/docflow
DF_VERSION=1.0.0
POSTGRES_VERSION=16.4
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://docflow.plant.local
SECRETS_DIR=/etc/docflow/secrets        # database_url, poster_database_url, postgres_password, jwt_secret, url_signing_key, s3_access_key,
                                        # s3_secret_key, imap_ap_inbox, sftp_key, erp_rest_token, smtp_url, webhook_hmac, cloud_model_key (0400 root:10001)
CONFIG_DIR=/etc/docflow                 # docflow.yaml
SCAN_HOT_FOLDER=/srv/scans/docflow      # mounted into intake-folder (IF-45)
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile
CPU_THREADS=8                           # cpu profile
DEFAULT_LOCALE=th

# ---- database
POSTGRES_DB=docflow
POSTGRES_USER=docflow
PG_SHARED_BUFFERS=2GB

# ---- redis / object store (ICD-08 IF-10)
REDIS_MAXMEMORY=512mb
S3_REGION=ap-southeast-1
S3_BUCKET_ORIGINALS=originals           # object lock, compliance mode (C-06)
S3_BUCKET_PAGES=pages
S3_BUCKET_EXPORTS=exports
S3_BUCKET_INTAKE=intake
ORIGINALS_RETENTION_DAYS=2557           # 7 years (SRS §5)
EXPORT_FILES_DAYS=30

# ---- api
MAX_UPLOAD_MB=50
SIGNED_URL_PAGE_TTL_S=900
SIGNED_URL_ORIGINAL_TTL_S=300
MAIL_FROM=DocFlow <no-reply@plant.local>

# ---- intake (IF-44 / IF-45)
IMAP_POLL_S=60
FOLDER_POLL_S=30
MAIL_BODY_EXCERPT_CHARS=500             # SEC-D35

# ---- OCR (IF-46)
OCR_LANGS=tha+jpn+jpn_vert+eng
PAGE_DPI=150
OCR_TIMEOUT_S=120
OCR_THREADS=4
OCR_CPUS=4
OCR_MEMORY=4g

# ---- extraction (IF-09 / IF-47)
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M # ≤ 9 B (SRS §2.3)
PROMPT_VERSION=p-2026.09
REPAIR_ROUNDS_MAX=2                     # ADR-D01
LLM_TIMEOUT_S=90
INJECTION_FLAG_SCORE=0.80               # AI-07

# ---- posting (IF-07)
ERP_TIMEOUT_S=30
POSTING_MAX_ATTEMPTS=5                  # FR-32

# ---- scheduler
MASTER_SYNC_CRON=*/30 * * * *
RETENTION_CRON=30 2 * * *
EVAL_CRON=0 3 * * 1
DRIFT_CRON=15 3 * * *
EXPORT_ACK_POLL_S=60
