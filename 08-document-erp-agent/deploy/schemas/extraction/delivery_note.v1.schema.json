{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docflow.example/schemas/extraction/delivery_note.v1.schema.json",
  "title": "DocFlow extraction — delivery note (delivery_note.v1)",
  "description": "Schema-constrained extraction output (SRS-08 C-02, AI-02; ICD-08 IF-47). The model decodes against this schema; the output is validated and re-prompted with the validator's errors (≤ 2 rounds), never coerced. Every field is {value, confidence, page?, bbox?, raw?}; amounts are numbers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_type",
    "header",
    "lines"
  ],
  "properties": {
    "schema_version": {
      "const": "delivery_note.v1"
    },
    "doc_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "confidence"
      ],
      "properties": {
        "value": {
          "type": "string",
          "enum": [
            "delivery_note"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "x0, y0, x1, y1 in full-derivative pixels"
        },
        "raw": {
          "type": "string",
          "description": "original text before normalisation (FR-13)"
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dn_number",
        "supplier"
      ],
      "properties": {
        "dn_number": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            }
          }
        },
        "date": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "ISO 8601 after normalisation (Buddhist/Reiwa dates in `raw`)"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            }
          }
        },
        "po_number": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            }
          }
        },
        "supplier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            },
            "matched_id": {
              "type": "string"
            }
          }
        },
        "ship_to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            }
          }
        },
        "notes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "confidence"
          ],
          "properties": {
            "value": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "bbox": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4,
              "description": "x0, y0, x1, y1 in full-derivative pixels"
            },
            "raw": {
              "type": "string",
              "description": "original text before normalisation (FR-13)"
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_no",
          "qty",
          "confidence"
        ],
        "properties": {
          "line_no": {
            "type": "integer",
            "minimum": 1
          },
          "part_no": {
            "type": "string"
          },
          "matched_item": {
            "type": "string",
            "description": "item master id resolved by validation, e.g. ITM-8891"
          },
          "description": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "delivery_date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 after normalisation (Buddhist/Reiwa dates in `raw`)"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Added by worker-validate (FR-22) — never produced by the model. Present in the stored extraction output (Appendix A shape).",
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "gate": {
          "type": "string",
          "enum": [
            "auto_clear",
            "review_required",
            "blocked"
          ]
        }
      }
    }
  }
}
