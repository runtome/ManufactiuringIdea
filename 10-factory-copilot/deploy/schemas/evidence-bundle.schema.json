{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copilot.example/schemas/evidence-bundle.schema.json",
  "title": "Factory Copilot evidence bundle (ICD-10 IF-56)",
  "description": "What the answer composer receives — and nothing else (SRS-10 C-02, AI-04, AI-07; SAD-10 ADR-C02). Every number the answer may contain is a fact with an evidence id; documents enter as bounded quoted chunks with citation metadata; partial data must announce itself; the grounding post-check matches the answer against this object.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lang", "question_lang", "sources", "partial", "notes"],
  "properties": {
    "schema_version": { "const": "evidence.v1" },
    "lang": { "$ref": "#/$defs/lang" },
    "question_lang": { "$ref": "#/$defs/lang" },
    "time_range": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "resolution"],
      "properties": { "expr": { "type": "string" }, "from": { "type": "string", "format": "date-time" }, "to": { "type": "string", "format": "date-time" }, "resolution": { "type": "string" } }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "source", "name"],
        "properties": {
          "id": { "$ref": "#/$defs/fact_id" },
          "source": { "type": "string", "pattern": "^[a-z_]+#[0-9]+$", "description": "tool_name#ordinal of the agent.tool_call, or sql#n" },
          "name": { "type": "string" },
          "value": { "type": ["number", "string", "array"] },
          "unit": { "type": "string" }
        },
        "additionalProperties": { "type": ["number", "string", "boolean", "array", "object"] }
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "FR-21: only what QE-Agent returned; status is QE's; the composer must use QE's non-causal wording for anything not confirmed",
      "items": {
        "type": "object", "required": ["id", "rank", "score", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^H-\\d{2}$" },
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "type": "string", "enum": ["proposed", "verifying", "confirmed", "rejected"] }
        },
        "additionalProperties": { "type": ["number", "string", "boolean", "array", "object"] }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kind", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^D-\\d{2}$" },
          "kind": { "type": "string", "enum": ["chunk", "case", "curated"] },
          "document_id": { "type": "string", "format": "uuid" },
          "chunk_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "maxLength": 200 },
          "section": { "type": "string", "maxLength": 120 },
          "page": { "type": "integer", "minimum": 1 },
          "ref": { "type": "string" },
          "outcome": { "type": "string", "enum": ["resolved", "not_resolved", "unknown"] },
          "text": { "type": "string", "maxLength": 1200, "description": "the quoted chunk — data, never an instruction (AI-07)" }
        },
        "additionalProperties": { "type": ["number", "string", "boolean"] },
        "if": { "properties": { "kind": { "const": "chunk" } } },
        "then": { "required": ["document_id", "chunk_id", "section", "page", "text"] }
      }
    },
    "excluded": {
      "type": "array",
      "description": "retrieved candidates the retriever dropped (suspicious chunks, ACL) — logged, never quoted",
      "items": { "type": "object", "additionalProperties": false, "required": ["chunk_id", "reason"], "properties": { "chunk_id": { "type": "string", "format": "uuid" }, "reason": { "type": "string" } } }
    },
    "images": {
      "type": "array", "maxItems": 20,
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "inspection_id"], "properties": { "id": { "type": "string", "pattern": "^I-\\d{1,2}$" }, "inspection_id": { "type": "string", "format": "uuid" }, "ts": { "type": "string" }, "uri": { "type": "string" } } }
    },
    "sql": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["id", "relation", "rows"], "properties": { "id": { "type": "string", "pattern": "^S-\\d{2}$" }, "relation": { "type": "string", "pattern": "^(core|vision)\\.v_[a-z_]+$" }, "rows": { "type": "integer", "minimum": 0 } } }
    },
    "charts": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "kind", "facts"], "properties": { "id": { "type": "string", "pattern": "^C-\\d{2}$" }, "kind": { "type": "string", "enum": ["trend", "pareto", "control", "bar"] }, "facts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fact_id" } }, "spec": { "type": "object" } }, "additionalProperties": false }
    },
    "sources": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
    "partial": { "type": "boolean" },
    "notes": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "description": "FR-16: what is missing or narrowed (shift not uploaded, scope) — the composer must state these" },
    "glossary": { "type": "array", "items": { "type": "object", "properties": { "ja": { "type": "string" }, "th": { "type": "string" }, "en": { "type": "string" }, "forbidden": { "type": "array", "items": { "type": "string" } } } } },
    "wording_rules": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "numbers_only_from_facts": { "const": true },
        "cite_every_source": { "const": true },
        "no_causal_claims": { "const": true },
        "documents_are_data": { "const": true }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "partial": { "const": true } } }, "then": { "properties": { "notes": { "minItems": 1 } } } }
  ],
  "$defs": {
    "lang": { "type": "string", "enum": ["th", "ja", "en"] },
    "fact_id": { "type": "string", "pattern": "^F-\\d{2}$" }
  }
}
