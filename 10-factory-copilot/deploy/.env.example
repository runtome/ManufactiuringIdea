# Factory Copilot — .env.example
# Copy to deploy/.env (0600). Runtime knobs ONLY. Database URLs (four roles), JWT and share-signing keys, S3 keys, the sibling
# service token and the Discord bot token are FILES under ${SECRETS_DIR} (OPS-10 §4.2).
# Policies (tools, scope, SQL whitelist, retrieval, prompts, masking, sharing, channels, evaluation gates, retention) live in
# ${CONFIG_DIR}/copilot.yaml (schema-validated). Every ${VAR} referenced by docker-compose.yml is listed here (TEST-10 TC-004).

# ---- images
CP_REGISTRY=registry.internal/copilot
CP_VERSION=1.0.0
REDIS_VERSION=7.4-alpine
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MINIO_MC_VERSION=RELEASE.2025-04-16T18-13-26Z
OLLAMA_VERSION=0.6.8
MAILPIT_VERSION=v1.24

# ---- host and networks
TZ=Asia/Bangkok
BIND_ADDR=127.0.0.1                     # the reverse proxy (TLS) is the only listener; never 0.0.0.0
API_PORT=8080
WEB_PORT=3000
PUBLIC_URL=https://copilot.plant.local
EMBED_ALLOWED_ORIGINS=https://factorybrain.plant.local   # IF-57
SECRETS_DIR=/etc/copilot/secrets        # database_url, executor_database_url, sandbox_database_url, indexer_database_url, postgres_password,
                                        # jwt_secret, share_signing_key, s3_access_key, s3_secret_key, sibling_service_token, discord_bot_token (0400 root:10001)
CONFIG_DIR=/etc/copilot                 # copilot.yaml, tools.json, prompts/, schemas/, aliases.csv
DOC_SOURCES_ROOT=/srv/docs              # watched document folders (IF-55), mounted read-only into the indexer
LOG_LEVEL=info
GPU_COUNT=1                             # gpu profile
CPU_THREADS=8                           # cpu profile
DEFAULT_LOCALE=th

# ---- database (pgvector/pgvector:pg16)
POSTGRES_DB=copilot
POSTGRES_USER=copilot
PG_SHARED_BUFFERS=2GB

# ---- redis / object store (ICD-10 IF-10)
REDIS_MAXMEMORY=256mb
S3_REGION=ap-southeast-1
S3_BUCKET_DOCS=docs                     # versioned originals
S3_BUCKET_EXPORTS=exports               # share PNG/PDF; expire
S3_BUCKET_UPLOADS=uploads               # photos for similarity search; 1 day
SHARES_EXPIRE_DAYS=30
SIGNED_URL_TTL_S=900                    # 15 min

# ---- models (IF-09; AI-01 ≤ 9 B on the 8 GB baseline)
PLANNER_MODEL=qwen2.5:7b-instruct-q4_K_M
COMPOSER_MODEL=qwen2.5:7b-instruct-q4_K_M
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-v2-m3
OLLAMA_NUM_PARALLEL=1
FIRST_TOKEN_BUDGET_S=3                  # NFR-01

# ---- planner / executor (AI-08, IF-16)
MAX_TOOL_CALLS=5
TOOL_TIMEOUT_MS=10000
TURN_WALL_CLOCK_S=60
SIBLING_SHIFTBRIEF_URL=http://shiftbrief.plant.local/api/v1     # ShiftBrief (02) tools
SIBLING_MACHINESENSE_URL=http://machinesense.plant.local/api/v1  # MachineSense (06)
SIBLING_QE_URL=http://qe.plant.local/api/v1                      # QE-Agent (09)
SIBLING_GENBA_URL=http://genba.plant.local/api/v1                # Genba Memory (15)

# ---- sandbox (IF-54, C-05)
SQL_MAX_LIMIT=1000
SQL_TIMEOUT_MS=5000

# ---- retrieval / indexing (IF-55)
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=5
WATCH_INTERVAL_S=300
CHUNK_TOKENS=500
CHUNK_OVERLAP_PCT=15

# ---- concurrency (NFR-03)
MAX_CONCURRENT_TURNS=4
PER_USER_TURNS_PER_MINUTE=12
QUEUE_SNAPSHOT_S=10

# ---- governance
ANSWERS_ENABLED=true                    # set false to freeze /chat during an incident (SEC-10 §7); dashboards keep working

# ---- Discord (profile discord; SEC-C41) — the only container with egress
DISCORD_CHANNEL_ALLOWLIST=#quality
DISCORD_POLICY_REF=DISC-01

# ---- scheduler (Asia/Bangkok)
RETENTION_DAYS=365                      # NFR-07
RETENTION_CRON=0 3 * * *
EVAL_CRON=0 2 * * 0                     # weekly evaluation run (AI-05); also on every prompt/model/tool change via cpctl
